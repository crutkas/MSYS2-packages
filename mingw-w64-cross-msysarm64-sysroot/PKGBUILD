_target=aarch64-pc-msys
_runtime_commit=6922c388be93e423c1186f0b58c39380a5ee9e2d
_runtime_root=msys2-runtime-${_runtime_commit}
_w32api_version=14.0.0.r0.g9b3dd0125

pkgbase=mingw-w64-cross-msysarm64-sysroot
pkgname=(
  mingw-w64-cross-msysarm64-headers
  mingw-w64-cross-msysarm64-windows-default-manifest
  mingw-w64-cross-msysarm64-sysroot
)
pkgver=3.6.10.r0.g6922c388b
pkgrel=1
pkgdesc="Compile-time MSYS/newlib/w32api sysroot for an aarch64-pc-msys target"
arch=('x86_64')
url="https://github.com/crutkas/msys2-runtime"
msys2_repository_url="https://github.com/crutkas/msys2-runtime"
license=('GPL' 'LGPL' 'custom')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
makedepends=('mingw-w64-cross-cygwinarm64-binutils')
options=('!strip' '!buildflags' '!emptydirs')
source=(
  "msys2-runtime-${_runtime_commit}.tar.gz::https://github.com/crutkas/msys2-runtime/archive/${_runtime_commit}.tar.gz"
  "w32api-headers-${_w32api_version}.tar.zst"
  newlib.h
  _newlib_version.h
  cygwin-compile-only.specs
  default-manifest.rc
  default.manifest
  README.md
  W32API-SNAPSHOT
  validate-sysroot.sh
  newlib-test.c
  winsup-test.c
  w32api-test.c
  abi-test.c
  sysroot-probe.s
)
