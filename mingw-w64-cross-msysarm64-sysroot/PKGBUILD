build() {
  local _headers="${srcdir}/sysroot-headers"
  local _manifest="${srcdir}/sysroot-default-manifest"
  local _prefix="opt/${_target}"

  rm -rf "${_headers}" "${_manifest}"
  mkdir -p \
    "${_headers}/${_prefix}/include" \
    "${_headers}/${_prefix}/lib" \
    "${_headers}/${_prefix}/share/msys-sysroot/tests" \
    "${_manifest}/${_prefix}/lib"

  cp -a "${srcdir}/${_runtime_root}/newlib/libc/include/." \
    "${_headers}/${_prefix}/include/"
  rm -f "${_headers}/${_prefix}/include/newlib.h"

  if [[ -d "${srcdir}/${_runtime_root}/newlib/libc/machine/aarch64/machine" ]]; then
    cp -a "${srcdir}/${_runtime_root}/newlib/libc/machine/aarch64/machine/." \
      "${_headers}/${_prefix}/include/machine/"
  fi
  if [[ -d "${srcdir}/${_runtime_root}/newlib/libc/machine/aarch64/include" ]]; then
    cp -a "${srcdir}/${_runtime_root}/newlib/libc/machine/aarch64/include/." \
      "${_headers}/${_prefix}/include/"
  fi

  cp -a "${srcdir}/${_runtime_root}/winsup/cygwin/include/." \
    "${_headers}/${_prefix}/include/"
  cp -a "${srcdir}/w32api/." \
    "${_headers}/${_prefix}/include/w32api/"

  install -m644 \
    "${srcdir}/newlib.h" \
    "${_headers}/${_prefix}/include/newlib.h"
  install -m644 \
    "${srcdir}/_newlib_version.h" \
    "${_headers}/${_prefix}/include/_newlib_version.h"
  install -m644 \
    "${srcdir}/cygwin-compile-only.specs" \
    "${_headers}/${_prefix}/lib/cygwin-compile-only.specs"

  install -m644 \
    "${srcdir}/README.md" \
    "${srcdir}/W32API-SNAPSHOT" \
    "${_headers}/${_prefix}/share/msys-sysroot/"
  install -m755 \
    "${srcdir}/validate-sysroot.sh" \
    "${_headers}/${_prefix}/share/msys-sysroot/"
  install -m644 \
    "${srcdir}/newlib-test.c" \
    "${srcdir}/winsup-test.c" \
    "${srcdir}/w32api-test.c" \
    "${srcdir}/abi-test.c" \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/"
  mv \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/newlib-test.c" \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/newlib.c"
  mv \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/winsup-test.c" \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/winsup.c"
  mv \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/w32api-test.c" \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/w32api.c"
  mv \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/abi-test.c" \
    "${_headers}/${_prefix}/share/msys-sysroot/tests/abi.c"

  aarch64-pc-cygwin-windres \
    --preprocessor=/usr/bin/cpp \
    --input="${srcdir}/default-manifest.rc" \
    --output="${_manifest}/${_prefix}/lib/default-manifest.o"

  aarch64-pc-cygwin-objdump -f \
    "${_manifest}/${_prefix}/lib/default-manifest.o" \
    | grep -F "file format pe-aarch64-little"

  {
    (
      cd "${_headers}"
      find opt -type f -print0 | sort -z | xargs -0 sha256sum
    )
    (
      cd "${_manifest}"
      find opt -type f -print0 | sort -z | xargs -0 sha256sum
    )
  } | sort -k2 \
    > "${srcdir}/sysroot-manifest.sha256"
}

check() {
  local _headers="${srcdir}/sysroot-headers"
  local _manifest="${srcdir}/sysroot-default-manifest"
  local _prefix="opt/${_target}"

  test -f "${_headers}/${_prefix}/include/newlib.h"
  test -f "${_headers}/${_prefix}/include/cygwin/version.h"
  test -f "${_headers}/${_prefix}/include/w32api/windows.h"
  test -f "${_headers}/${_prefix}/lib/cygwin-compile-only.specs"
  test -f "${_manifest}/${_prefix}/lib/default-manifest.o"
  test -f "${srcdir}/sysroot-manifest.sha256"
  test -z "$(
    awk '{print $2}' "${srcdir}/sysroot-manifest.sha256" \
      | sort | uniq -d
  )"

  ! find "${_headers}" "${_manifest}" -type f \
    \( -name '*.dll' -o -name '*.exe' -o -name 'crt0.o' \
       -o -name 'libcygwin.a' -o -name 'libmsys-2.0.a' \) \
    | grep -q .

  aarch64-pc-cygwin-objdump -f \
    "${_manifest}/${_prefix}/lib/default-manifest.o" \
    | grep -F "architecture: aarch64"

  (
    cd "${srcdir}"
    aarch64-pc-cygwin-as -o sysroot-probe.o \
      "${srcdir}/sysroot-probe.s"
    aarch64-pc-cygwin-objdump -f sysroot-probe.o \
      | grep -F "file format pe-aarch64-little"
    rm -f sysroot-probe.o
  )
}

package_mingw-w64-cross-msysarm64-headers() {
  pkgdesc="MSYS, newlib, and w32api headers for aarch64-pc-msys"
  provides=("aarch64-pc-msys-headers=${pkgver}")
  conflicts=('aarch64-pc-msys-headers'
             'mingw-w64-cross-cygwinarm64-headers')

  cp -a "${srcdir}/sysroot-headers/." "${pkgdir}/"
}

package_mingw-w64-cross-msysarm64-windows-default-manifest() {
  pkgdesc="Default Windows application manifest for aarch64-pc-msys"
  provides=("aarch64-pc-msys-windows-default-manifest=${pkgver}")
  conflicts=('aarch64-pc-msys-windows-default-manifest'
             'mingw-w64-cross-cygwinarm64-windows-default-manifest')

  cp -a "${srcdir}/sysroot-default-manifest/." "${pkgdir}/"
}

package_mingw-w64-cross-msysarm64-sysroot() {
  pkgdesc="Compile-only sysroot package set for aarch64-pc-msys"
  depends=(
    "mingw-w64-cross-msysarm64-headers=${pkgver}-${pkgrel}"
    "mingw-w64-cross-msysarm64-windows-default-manifest=${pkgver}-${pkgrel}"
  )
  provides=("aarch64-pc-msys-sysroot=${pkgver}")
  conflicts=('aarch64-pc-msys-sysroot'
             'mingw-w64-cross-cygwinarm64-sysroot')

  install -Dm644 \
    "${srcdir}/sysroot-manifest.sha256" \
    "${pkgdir}/usr/share/msys-sysroot/sysroot-manifest.sha256"
}
