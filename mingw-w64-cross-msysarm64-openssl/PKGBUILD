_source_root="${_realname}-${pkgver}"
_dest_name="dest-${_target}"
_report_name=openssl-report

prepare() {
  [[ -d "${srcdir}/${_source_root}" ]] \
    || tar -xzf "${srcdir}/${_realname}-${pkgver}.tar.gz" -C "${srcdir}"
  cd "${srcdir}/${_source_root}"

  patch -Np1 -i "${srcdir}/0001-Use-usr-ssl-as-ca-dir-instead-of-.-demoCA.patch"
  patch -Np1 -i "${srcdir}/0002-Support-MSYS2.patch"
  patch -Np1 -i "${srcdir}/0004-Override-engines-directory.patch"
  patch -Np1 -i "${srcdir}/0005-skip-dllmain-detach.patch"
  patch -Np1 -i "${srcdir}/0006-Add-Cygwin-aarch64-target.patch"
  patch -Np1 -i "${srcdir}/0007-Fix-AArch64-Cygwin-LP64-detection.patch"
}

build() {
  local _dest="${srcdir}/${_dest_name}"
  local _report="${srcdir}/${_report_name}"

  cd "${srcdir}/${_source_root}"

  rm -rf "${_dest}" "${_report}"
  mkdir -p "${_dest}" "${_report}"

  export PATH="/opt/bin:/usr/bin/core_perl:${PATH}"
  export MSYSTEM=CYGWIN
  export CPPFLAGS="${CPPFLAGS:-} -D__MSYS__"
  export CFLAGS="${CFLAGS:-} -O2 -pipe"

  if [[ ! -f configdata.pm ]] \
      || ! grep -Eq 'target.*Cygwin-aarch64' configdata.pm; then
    ./Configure \
      "--cross-compile-prefix=${_target}-" \
      --prefix=/usr \
      --openssldir=/usr/ssl \
      --libdir=lib \
      shared \
      no-asm \
      no-tests \
      Cygwin-aarch64
    make depend
  fi

  make -j8 all
  make \
    DESTDIR="${_dest}" \
    MANDIR=/usr/share/man \
    MANSUFFIX=ssl \
    -j1 \
    install_sw \
    install_ssldirs \
    install_man_docs
}

check() {
  local _dest="${srcdir}/${_dest_name}"
  local _report="${srcdir}/${_report_name}"

  export PATH="/opt/bin:${PATH}"

  TARGET="${_target}" \
  TOOL_TARGET="${_tool_target}" \
  BINUTILS_RELEASE_TAG="${_binutils_release_tag}" \
  BINUTILS_VERSION="${_binutils_version}-${_binutils_pkgrel}" \
  LINKER_SHA256="${_linker_sha256}" \
  OPENSSL_VERSION="${pkgver}" \
  RUNTIME_RELEASE_TAG="${_runtime_release_tag}" \
  RUNTIME_VERSION="${_runtime_version}-${_runtime_pkgrel}" \
  GCC_RELEASE_TAG="${_gcc_release_tag}" \
  GCC_VERSION="${_gcc_version}-${_gcc_pkgrel}" \
  SMOKE_SOURCES_DIR="${srcdir}" \
    bash "${srcdir}/validate-openssl.sh" \
      "${_dest}" \
      "${srcdir}/${_source_root}" \
      "${srcdir}/openssl-smoke.c" \
      "${_report}" \
      "${srcdir}/check-aarch64-pseudo-relocs.ps1"
}

package_mingw-w64-cross-msysarm64-openssl() {
  local _dest="${srcdir}/${_dest_name}"
  local _pkgroot="${pkgdir}/opt/${_target}/usr"
  local _staged="${_dest}/usr"

  pkgdesc="OpenSSL command-line tools for aarch64-pc-msys"
  depends=(
    "mingw-w64-cross-msysarm64-libopenssl=${pkgver}-${pkgrel}"
    "mingw-w64-cross-msysarm64-runtime=${_runtime_version}-${_runtime_pkgrel}"
  )
  optdepends=('aarch64-pc-msys-perl: c_rehash support')
  provides=("aarch64-pc-msys-openssl=${pkgver}")
  conflicts=('aarch64-pc-msys-openssl')

  install -d "${_pkgroot}/bin" "${_pkgroot}/share/man"
  install -m755 "${_staged}/bin/openssl.exe" "${_pkgroot}/bin/"
  install -m755 "${_staged}/bin/c_rehash" "${_pkgroot}/bin/"
  cp -a "${_staged}/share/man/man1" "${_pkgroot}/share/man/"
  cp -a "${_staged}/share/man/man5" "${_pkgroot}/share/man/"
  cp -a "${_staged}/ssl" "${_pkgroot}/"
}

package_mingw-w64-cross-msysarm64-libopenssl() {
  local _dest="${srcdir}/${_dest_name}"
  local _pkgroot="${pkgdir}/opt/${_target}/usr"
  local _staged="${_dest}/usr"
  local _licensedir="${pkgdir}/usr/share/licenses/${pkgname}"

  pkgdesc="OpenSSL runtime libraries and providers for aarch64-pc-msys"
  depends=("mingw-w64-cross-msysarm64-runtime=${_runtime_version}-${_runtime_pkgrel}")
  groups=('libraries')
  provides=("aarch64-pc-msys-libopenssl=${pkgver}")
  conflicts=('aarch64-pc-msys-libopenssl')

  install -d "${_pkgroot}/bin" "${_pkgroot}/lib"
  install -m755 "${_staged}/bin/"*.dll "${_pkgroot}/bin/"
  cp -a "${_staged}/lib/openssl" "${_pkgroot}/lib/"
  cp -a "${_staged}/lib/ossl-modules" "${_pkgroot}/lib/"
  chmod -R 755 "${_pkgroot}/lib/openssl" "${_pkgroot}/lib/ossl-modules"
  install -Dm644 "${srcdir}/${_source_root}/LICENSE.txt" \
    "${_licensedir}/LICENSE.txt"
}

package_mingw-w64-cross-msysarm64-openssl-devel() {
  local _dest="${srcdir}/${_dest_name}"
  local _report="${srcdir}/${_report_name}"
  local _pkgroot="${pkgdir}/opt/${_target}/usr"
  local _staged="${_dest}/usr"
  local _licensedir="${pkgdir}/usr/share/licenses/${pkgname}"
  local _reportdir="${pkgdir}/opt/${_target}/share/msys-sysroot/openssl"

  pkgdesc="OpenSSL headers and libraries for aarch64-pc-msys"
  depends=(
    "mingw-w64-cross-msysarm64-libopenssl=${pkgver}-${pkgrel}"
    "mingw-w64-cross-msysarm64-runtime-devel=${_runtime_version}-${_runtime_pkgrel}"
    "mingw-w64-cross-msysarm64-sysroot=${_runtime_version}-${_runtime_pkgrel}"
  )
  groups=('development')
  options=('staticlibs' '!strip' '!buildflags' '!emptydirs')
  provides=("aarch64-pc-msys-openssl-devel=${pkgver}")
  conflicts=('aarch64-pc-msys-openssl-devel')

  install -d "${_pkgroot}" "${_reportdir}"
  cp -a "${_staged}/include" "${_pkgroot}/"
  install -d "${_pkgroot}/lib"
  cp -a "${_staged}/lib/pkgconfig" "${_pkgroot}/lib/"
  install -m644 "${_staged}/lib/"*.a "${_pkgroot}/lib/"
  cp -a "${_report}/." "${_reportdir}/"
  install -m755 "${srcdir}/validate-openssl.sh" "${_reportdir}/"
  install -m644 "${srcdir}/check-aarch64-pseudo-relocs.ps1" "${_reportdir}/"
  install -m755 "${srcdir}/native-smoke.sh" "${_reportdir}/"
  install -m644 "${srcdir}/openssl-smoke.c" "${_reportdir}/"
  install -m644 \
    "${srcdir}/dlopen-generic.c" \
    "${srcdir}/dlopen-crypto.c" \
    "${srcdir}/dlopen-smoke.c" \
    "${srcdir}/provider-minimal.c" \
    "${_reportdir}/"
  install -m644 "${srcdir}/README.md" "${_reportdir}/"
  install -Dm644 "${srcdir}/${_source_root}/LICENSE.txt" \
    "${_licensedir}/LICENSE.txt"
}

package_mingw-w64-cross-msysarm64-openssl-docs() {
  local _dest="${srcdir}/${_dest_name}"
  local _pkgroot="${pkgdir}/opt/${_target}/usr"
  local _staged="${_dest}/usr"
  local _licensedir="${pkgdir}/usr/share/licenses/${pkgname}"

  pkgdesc="OpenSSL API documentation for aarch64-pc-msys"
  provides=("aarch64-pc-msys-openssl-docs=${pkgver}")
  conflicts=('aarch64-pc-msys-openssl-docs')

  install -d "${_pkgroot}/share/man"
  cp -a "${_staged}/share/man/man3" "${_pkgroot}/share/man/"
  cp -a "${_staged}/share/man/man7" "${_pkgroot}/share/man/"
  install -Dm644 "${srcdir}/${_source_root}/LICENSE.txt" \
    "${_licensedir}/LICENSE.txt"
}
