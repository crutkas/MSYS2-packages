prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  patch -p1 -i "${srcdir}/gnulib-weak.patch"
  patch -p1 -i "${srcdir}/gpg-error-static-linking.patch"
  perl -0pi -e 's/case "\$\{host\}" in\n    x86_64-\*mingw32\*\)\n        have_w32_system=yes\n        have_w64_system=yes\n        ;;/case "${host}" in\n    x86_64-*mingw32*)\n        have_w32_system=yes\n        have_w64_system=yes\n        ;;/s' configure.ac
  perl -0pi -e 's/if \(!strcmp \(host_os, "mingw32"\)\)\n        \{\n          include_file \(fname, lnr, "w32-add.h", write_line\);\n        \}/if (!strcmp (host_os, "mingw32"))\n        {\n          include_file (fname, lnr, "w32-add.h", write_line);\n        }/s; s/include_file \(fname, lnr, "syscfg\/lock-obj-pub\.\&\.h", write_line\);/if (!strcmp (host_os, "msys"))\n            include_file (fname, lnr,\n                          "syscfg\/lock-obj-pub.mingw32.h", write_line);\n          else\n            include_file (fname, lnr, "syscfg\/lock-obj-pub.&.h", write_line);/s' src/mkheader.c
  perl -0pi -e 's/cygwin\* \| mingw\* \| windows\* \| pw32\* \| cegcc\*/cygwin* | msys* | mingw* | windows* | pw32* | cegcc*/g; s/cygwin\*\)/cygwin* | msys*)/g' m4/libtool.m4
  autoreconf -fi
}

build() {
  cd "${srcdir}/${_realname}-${pkgver}"

  local _build_triplet="$(gcc -dumpmachine)"
  local _target_include="-isystem /opt/${_target}/include -isystem /opt/${_target}/include/w32api"
  local _target_defs=""

  export PATH="/opt/bin:${PATH}"
  export lt_cv_deplibs_check_method='pass_all'
  export lt_cv_archive_cmds_need_lc='no'
  export ARFLAGS='crsD'
  export CPPFLAGS="${CPPFLAGS:-} ${_target_defs} ${_target_include}"
  export CFLAGS="${CFLAGS:-} ${_target_defs} ${_target_include}"
  export CXXFLAGS="${CXXFLAGS:-} ${_target_defs} ${_target_include}"

  perl -0pi -e 's/cygwin\* \| mingw\* \| windows\* \| pw32\* \| cegcc\*/cygwin* | msys* | mingw* | windows* | pw32* | cegcc*/g; s/\n    cygwin\*\)\n      # Cygwin DLLs use '\''cyg'\'' prefix rather than '\''lib'\''/\n    cygwin* | msys*)\n      # Cygwin DLLs use '\''cyg'\'' prefix rather than '\''lib'\''/g' configure

  ./configure \
    CC="aarch64-pc-msys-gcc" \
    AR="aarch64-pc-cygwin-ar" \
    RANLIB="aarch64-pc-cygwin-ranlib" \
    LD="aarch64-pc-msys-ld" \
    NM="aarch64-pc-msys-nm" \
    STRIP="aarch64-pc-msys-strip" \
    DLLTOOL="aarch64-pc-msys-dlltool" \
    WINDRES="aarch64-pc-msys-windres" \
    CC_FOR_BUILD=gcc \
    --prefix=/usr \
    --build="${_build_triplet}" \
    --host="${_target}" \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --enable-install-gpg-error-config \
    --enable-shared \
    --enable-static

  make no_undefined=-no-undefined
  make DESTDIR="${srcdir}/dest" install
}

check() {
  local _dest="${srcdir}/dest"
  local _pkgroot="${_dest}/usr"
  local _dll
  local _exe

  test -f "${srcdir}/${_realname}-${pkgver}/src/gpg-error.h"
  test -f "${srcdir}/${_realname}-${pkgver}/src/gpgrt.h"
  test -f "${srcdir}/${_realname}-${pkgver}/src/gpg-error.def"
  test -f "${_pkgroot}/include/gpg-error.h"
  test -f "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  test -f "${_pkgroot}/bin/gpg-error-config"
  _dll="$(find "${_pkgroot}/lib" -maxdepth 1 -type f -name '*.dll' | head -n 1)"
  _exe="$(find "${_pkgroot}/bin" -maxdepth 1 -type f -name '*.exe' | head -n 1)"
  test -f "${_pkgroot}/lib/libgpg-error.a"
  test -n "${_dll}"
  test -n "${_exe}"

  aarch64-pc-msys-objdump -f "${_dll}" | grep -F "file format pei-aarch64-little"
  aarch64-pc-msys-objdump -p "${_dll}" | grep -F "msys-2.0.dll"
  ! aarch64-pc-msys-objdump -p "${_dll}" | grep -Ei 'cygwin1\.dll|x86_64'

  aarch64-pc-msys-objdump -f "${_exe}" | grep -F "file format pei-aarch64-little"
  ! aarch64-pc-msys-objdump -p "${_exe}" | grep -Ei 'cygwin1\.dll|x86_64'

  grep -F 'prefix=/usr' "${_pkgroot}/bin/gpg-error-config"
  grep -F 'prefix=/usr' "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  grep -F 'Libs.private:' "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  grep -F '/usr' "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  aarch64-pc-msys-nm -s "${_pkgroot}/lib/libgpg-error.a" | grep -F 'Archive index:'
}

package_mingw-w64-cross-msysarm64-libgpg-error() {
  pkgdesc="ARM64 MSYS runtime library for GnuPG"
  depends=("aarch64-pc-msys-runtime=${_runtime_version}")
  provides=("aarch64-pc-msys-libgpg-error=${pkgver}")
  conflicts=('aarch64-pc-msys-libgpg-error')

  mkdir -p "${pkgdir}/opt/${_target}/usr/bin" "${pkgdir}/opt/${_target}/usr/share"
  cp -a "${srcdir}/dest/usr/bin" "${pkgdir}/opt/${_target}/usr/"
  cp -a "${srcdir}/dest/usr/lib"/*.dll "${pkgdir}/opt/${_target}/usr/bin/"
  rm -f "${pkgdir}/opt/${_target}/usr/bin"/*-config
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}

package_mingw-w64-cross-msysarm64-libgpg-error-devel() {
  pkgdesc="ARM64 MSYS libgpg-error headers and libraries"
  groups=('development')
  depends=("aarch64-pc-msys-libgpg-error=${pkgver}" "aarch64-pc-msys-runtime=${_runtime_version}")
  provides=("aarch64-pc-msys-libgpg-error-devel=${pkgver}")
  conflicts=('aarch64-pc-msys-libgpg-error-devel')
  options=('staticlibs' '!strip')

  mkdir -p "${pkgdir}/opt/${_target}/usr/bin" "${pkgdir}/opt/${_target}/usr/share"
  cp -a "${srcdir}/dest/usr/bin"/*-config "${pkgdir}/opt/${_target}/usr/bin/"
  cp -a "${srcdir}/dest/usr/include" "${pkgdir}/opt/${_target}/usr/"
  cp -a "${srcdir}/dest/usr/lib" "${pkgdir}/opt/${_target}/usr/"
  rm -f "${pkgdir}/opt/${_target}/usr/lib"/*.dll
  aarch64-pc-cygwin-ranlib "${pkgdir}/opt/${_target}/usr/lib/libgpg-error.a"
  cp -a "${srcdir}/dest/usr/share/aclocal" "${pkgdir}/opt/${_target}/usr/share/"
  cp -a "${srcdir}/dest/usr/share/common-lisp" "${pkgdir}/opt/${_target}/usr/share/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}
