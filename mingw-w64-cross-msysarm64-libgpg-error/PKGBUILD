_realname=libgpg-error
_target=aarch64-pc-msys
_runtime_release_tag=msysarm64-runtime-pr10-20260822
_runtime_version=3.6.10.r0.gc7932d64f
_runtime_pkgrel=1
_sysroot_version=3.6.10.r0.gc7932d64f
_sysroot_pkgrel=1

pkgbase=mingw-w64-cross-msysarm64-libgpg-error
pkgname=(
  mingw-w64-cross-msysarm64-libgpg-error
  mingw-w64-cross-msysarm64-libgpg-error-devel
)
pkgver=1.55
pkgrel=1
pkgdesc="ARM64 MSYS support library for GnuPG"
arch=('x86_64')
url="https://gnupg.org"
msys2_repository_url="https://git.gnupg.org/cgi-bin/gitweb.cgi?p=libgpg-error.git"
msys2_references=(
  "cpe: cpe:/a:gnupg:libgpg-error"
)
license=('spdx:LGPL-2.1-or-later')
depends=("aarch64-pc-msys-runtime=${_runtime_version}")
makedepends=(
  'autotools'
  'gcc'
  'gettext-devel'
  'libiconv-devel'
  'mingw-w64-cross-cygwinarm64-binutils'
  'mingw-w64-cross-cygwinarm64-gcc-stage1'
  "mingw-w64-cross-msysarm64-runtime-devel=${_runtime_version}-${_runtime_pkgrel}"
  "mingw-w64-cross-msysarm64-sysroot=${_sysroot_version}-${_sysroot_pkgrel}"
  'mingw-w64-cross-msysarm64-w32api-runtime=14.0.0.r0.g9b3dd0125-1'
)
options=('!strip' '!buildflags' '!emptydirs')
source=(
  "${_realname}-${pkgver}.tar.bz2::https://gnupg.org/ftp/gcrypt/${_realname}/${_realname}-${pkgver}.tar.bz2"
  "${_realname}-${pkgver}.tar.bz2.sig::https://gnupg.org/ftp/gcrypt/${_realname}/${_realname}-${pkgver}.tar.bz2.sig"
  gnulib-weak.patch
  gpg-error-static-linking.patch
)
sha256sums=('95b178148863f07d45df0cea67e880a79b9ef71f5d230baddc0071128516ef78'
            'SKIP'
            'bb9fcb4713a62b28bddf0f6aa20e89b6b1e98bebce503bfa8efd5c1ff38a3c2f'
            '07a60fb641195effd91d4da06d3ca95d9481c9f35ac0e94f320d7db8a83fbd72')
#These might be signed by any of these keys https://gnupg.org/signature_key.html
validpgpkeys=('5B80C5754298F0CB55D8ED6ABCEF7E294B092E28'
              '6DAA6E64A76D2840571B4902528897B826403ADA'
              'AC8E115BF73E2D8D47FA9908E98E9B2D19C6C8BD'
              '02F38DFF731FF97CB039A1DA549E695E905BA208')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  patch -p1 -i "${srcdir}/gnulib-weak.patch"
  patch -p1 -i "${srcdir}/gpg-error-static-linking.patch"
  autoreconf -fi
}

build() {
  cd "${srcdir}/${_realname}-${pkgver}"

  local _build_triplet="$(gcc -dumpmachine | sed 's|-msys$|-cygwin|')"
  local _target_include="-isystem /opt/${_target}/include -isystem /opt/${_target}/include/w32api"
  local _target_defs="-D__MSYS__"

  export PATH="/opt/bin:${PATH}"
  export CPPFLAGS="${CPPFLAGS:-} ${_target_defs} ${_target_include}"
  export CFLAGS="${CFLAGS:-} ${_target_defs} ${_target_include}"
  export CXXFLAGS="${CXXFLAGS:-} ${_target_defs} ${_target_include}"

  ./configure \
    CC="aarch64-pc-cygwin-gcc" \
    AR="aarch64-pc-cygwin-ar" \
    RANLIB="aarch64-pc-cygwin-ranlib" \
    LD="aarch64-pc-cygwin-ld" \
    NM="aarch64-pc-cygwin-nm" \
    STRIP="aarch64-pc-cygwin-strip" \
    DLLTOOL="aarch64-pc-cygwin-dlltool" \
    WINDRES="aarch64-pc-cygwin-windres" \
    CC_FOR_BUILD=gcc \
    --prefix=/usr \
    --build="${_build_triplet}" \
    --host="${_target}" \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --enable-install-gpg-error-config \
    --enable-shared \
    --enable-static

  make no_undefined=-no-undefined
  make DESTDIR="${srcdir}/dest" install
}

check() {
  local _dest="${srcdir}/dest"
  local _pkgroot="${_dest}/usr"
  local _dll
  local _exe

  test -f "${srcdir}/${_realname}-${pkgver}/src/gpg-error.h"
  test -f "${srcdir}/${_realname}-${pkgver}/src/gpgrt.h"
  test -f "${srcdir}/${_realname}-${pkgver}/src/gpg-error.def"
  test -f "${_pkgroot}/include/gpg-error.h"
  test -f "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  test -f "${_pkgroot}/bin/gpg-error-config"
  test -d "${_pkgroot}/share/locale"

  _dll="$(find "${_pkgroot}/bin" -maxdepth 1 -type f -name '*.dll' | head -n 1)"
  _exe="$(find "${_pkgroot}/bin" -maxdepth 1 -type f -name '*.exe' | head -n 1)"
  test -n "${_dll}"
  test -n "${_exe}"

  aarch64-pc-cygwin-objdump -f "${_dll}" | grep -F "file format pe-aarch64-little"
  aarch64-pc-cygwin-objdump -p "${_dll}" | grep -F "msys-2.0.dll"
  ! aarch64-pc-cygwin-objdump -p "${_dll}" | grep -Ei 'cygwin1\.dll|x86_64'

  aarch64-pc-cygwin-objdump -f "${_exe}" | grep -F "file format pe-aarch64-little"
  ! aarch64-pc-cygwin-objdump -p "${_exe}" | grep -Ei 'cygwin1\.dll|x86_64'

  grep -F 'prefix=/usr' "${_pkgroot}/bin/gpg-error-config"
  grep -F 'prefix=/usr' "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  grep -F 'Libs.private:' "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
  grep -F '/usr' "${_pkgroot}/lib/pkgconfig/gpg-error.pc"
}

package_mingw-w64-cross-msysarm64-libgpg-error() {
  pkgdesc="ARM64 MSYS runtime library for GnuPG"
  depends=("aarch64-pc-msys-runtime=${_runtime_version}")
  provides=("aarch64-pc-msys-libgpg-error=${pkgver}")
  conflicts=('aarch64-pc-msys-libgpg-error')

  mkdir -p "${pkgdir}/opt/${_target}/usr/share"
  cp -a "${srcdir}/dest/usr/bin" "${pkgdir}/opt/${_target}/usr/"
  rm -f "${pkgdir}/opt/${_target}/usr/bin"/*-config
  cp -a "${srcdir}/dest/usr/share/locale" "${pkgdir}/opt/${_target}/usr/share/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}

package_mingw-w64-cross-msysarm64-libgpg-error-devel() {
  pkgdesc="ARM64 MSYS libgpg-error headers and libraries"
  groups=('development')
  depends=("aarch64-pc-msys-libgpg-error=${pkgver}" "aarch64-pc-msys-runtime=${_runtime_version}")
  provides=("aarch64-pc-msys-libgpg-error-devel=${pkgver}")
  conflicts=('aarch64-pc-msys-libgpg-error-devel')
  options=('staticlibs')

  mkdir -p "${pkgdir}/opt/${_target}/usr/{bin,share}"
  cp -a "${srcdir}/dest/usr/bin"/*-config "${pkgdir}/opt/${_target}/usr/bin/"
  cp -a "${srcdir}/dest/usr/include" "${pkgdir}/opt/${_target}/usr/"
  cp -a "${srcdir}/dest/usr/lib" "${pkgdir}/opt/${_target}/usr/"
  cp -a "${srcdir}/dest/usr/share/aclocal" "${pkgdir}/opt/${_target}/usr/share/"
  cp -a "${srcdir}/dest/usr/share/common-lisp" "${pkgdir}/opt/${_target}/usr/share/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}
