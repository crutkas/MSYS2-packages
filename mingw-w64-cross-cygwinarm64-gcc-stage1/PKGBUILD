_source_dir="${_realname}-woarm64-${_source_commit}"
_build_dir="build-${_target}-stage1"

build() {
  rm -rf "${srcdir}/${_build_dir}"
  mkdir -p "${srcdir}/${_build_dir}"
  cd "${srcdir}/${_build_dir}"

  export MSYSTEM=MSYS
  export lt_cv_deplibs_check_method=pass_all
  local _prefix_map="-ffile-prefix-map=${srcdir}=. -fdebug-prefix-map=${srcdir}=. -fmacro-prefix-map=${srcdir}=."
  export CFLAGS="-O2 -pipe ${_prefix_map}"
  export CXXFLAGS="-O2 -pipe ${_prefix_map}"
  export CFLAGS_FOR_BUILD="${CFLAGS}"
  export CXXFLAGS_FOR_BUILD="${CXXFLAGS}"

  "../${_source_dir}/configure" \
    --build="${_host}" \
    --host="${_host}" \
    --target="${_target}" \
    --prefix=/opt \
    --libexecdir=/opt/libexec \
    --with-sysroot="/opt/${_target}" \
    --with-build-sysroot="/opt/${_target}" \
    --with-build-time-tools="/opt/${_target}/bin" \
    --with-native-system-header-dir=/usr/include \
    --without-headers \
    --with-newlib \
    --with-abi=lp64 \
    --with-arch=armv8-a \
    --enable-multilib \
    --with-multilib-list=lp64 \
    --enable-languages=c,c++,lto \
    --enable-lto \
    --disable-plugin \
    --enable-static \
    --disable-shared \
    --disable-bootstrap \
    --disable-nls \
    --disable-rpath \
    --disable-threads \
    --disable-win32-registry \
    --disable-werror \
    --disable-libada \
    --disable-libatomic \
    --disable-libcc1 \
    --disable-libffi \
    --disable-libgfortran \
    --disable-libgm2 \
    --disable-libgomp \
    --disable-libitm \
    --disable-libobjc \
    --disable-libphobos \
    --disable-libquadmath \
    --disable-libsanitizer \
    --disable-libssp \
    --disable-libstdcxx \
    --disable-libvtv \
    --with-gmp=/usr \
    --with-isl=/usr \
    --with-mpc=/usr \
    --with-mpfr=/usr \
    --with-system-zlib

  make MAKEINFO=true all-gcc
}

_install_compiler() {
  local _root=$1

  cd "${srcdir}/${_build_dir}"
  make MAKEINFO=true DESTDIR="${_root}" install-gcc install-lto-plugin

  rm -rf \
    "${_root}/opt/include" \
    "${_root}/opt/lib/bfd-plugins" \
    "${_root}/opt/share"
  rm -f \
    "${_root}/opt/lib/libiberty.a" \
    "${_root}/opt/bin/${_target}-lto-dump.exe" \
    "${_root}/opt/bin/${_target}-gcov.exe" \
    "${_root}/opt/bin/${_target}-gcov-dump.exe" \
    "${_root}/opt/bin/${_target}-gcov-tool.exe"
  rm -f "${_root}/opt/bin/${_target}-${_target}-"*.exe
  rm -rf \
    "${_root}/opt/lib/gcc/${_target}/${_gcc_version}/install-tools" \
    "${_root}/opt/libexec/gcc/${_target}/${_gcc_version}/install-tools"

  find "${_root}/opt" -type f \( -name '*.exe' -o -name '*.dll' \) \
    -exec strip --strip-unneeded {} +
}

check() {
  local _check_root="${srcdir}/stage0-check-root"
  local _report_dir="${srcdir}/stage0-report"

  rm -rf "${_check_root}" "${_report_dir}"
  _install_compiler "${_check_root}"

  bash "${srcdir}/validate-stage0.sh" \
    "${_check_root}/opt" \
    "${_report_dir}"
}

package() {
  _install_compiler "${pkgdir}"

  local _docdir="${pkgdir}/opt/share/doc/${pkgname}"
  local _licensedir="${pkgdir}/opt/share/licenses/${pkgname}"
  install -d "${_docdir}" "${_licensedir}"
  install -m644 \
    "${srcdir}/README.stage0.md" \
    "${srcdir}/abi.c" \
    "${srcdir}/newlib-fragment.c" \
    "${srcdir}/register-pressure.c" \
    "${srcdir}/sysroot-fragment.c" \
    "${srcdir}/sysroot-fragment.cc" \
    "${srcdir}/tls.c" \
    "${srcdir}/unwind.c" \
    "${srcdir}/winsup-fragment.cc" \
    "${_docdir}/"
  install -m755 \
    "${srcdir}/validate-stage0.sh" \
    "${srcdir}/validate-sysroot.sh" \
    "${_docdir}/"
  install -m644 \
    "${srcdir}/${_source_dir}/COPYING3" \
    "${srcdir}/${_source_dir}/COPYING.RUNTIME" \
    "${_licensedir}/"

  bash "${srcdir}/validate-stage0.sh" \
    "${pkgdir}/opt" \
    "${_docdir}"
}
