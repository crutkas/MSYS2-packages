_source_dir="${_realname}-woarm64-${_source_commit}"
_runtime_dir="msys2-runtime-${_runtime_commit}"
_build_dir="build-${_target}-stage1"
_stage_dir="stage-${_target}-stage1"
_report_dir="static-runtime-report"

build() {
  rm -rf \
    "${srcdir}/${_build_dir}" \
    "${srcdir}/${_stage_dir}" \
    "${srcdir}/${_report_dir}" \
    "${srcdir}/runtime-build-${_target}"
  mkdir -p \
    "${srcdir}/${_build_dir}" \
    "${srcdir}/${_stage_dir}" \
    "${srcdir}/${_report_dir}"
  cd "${srcdir}/${_build_dir}"

  export MSYSTEM=MSYS
  export lt_cv_deplibs_check_method=pass_all
  local _prefix_map="-ffile-prefix-map=${srcdir}=. -fdebug-prefix-map=${srcdir}=. -fmacro-prefix-map=${srcdir}=."
  export CFLAGS="-O2 -pipe ${_prefix_map}"
  export CXXFLAGS="-O2 -pipe ${_prefix_map}"
  export CFLAGS_FOR_BUILD="${CFLAGS}"
  export CXXFLAGS_FOR_BUILD="${CXXFLAGS}"
  export CFLAGS_FOR_TARGET="-O2 -pipe ${_prefix_map}"
  export CXXFLAGS_FOR_TARGET="${CFLAGS_FOR_TARGET}"

  "../${_source_dir}/configure" \
    --build="${_host}" \
    --host="${_host}" \
    --target="${_target}" \
    --prefix=/opt \
    --libexecdir=/opt/libexec \
    --with-sysroot="/opt/${_target}" \
    --with-build-sysroot="/opt/${_target}" \
    --with-build-time-tools="/opt/${_target}/bin" \
    --with-native-system-header-dir=/include \
    --with-newlib \
    --with-abi=lp64 \
    --with-arch=armv8-a \
    --disable-multilib \
    --enable-languages=c,c++,lto \
    --enable-lto \
    --disable-plugin \
    --enable-static \
    --disable-shared \
    --disable-bootstrap \
    --disable-nls \
    --disable-rpath \
    --enable-threads=posix \
    --enable-__cxa_atexit \
    --disable-win32-registry \
    --disable-werror \
    --disable-libada \
    --disable-libatomic \
    --disable-libcc1 \
    --disable-libffi \
    --disable-libgfortran \
    --disable-libgm2 \
    --disable-libgomp \
    --disable-libitm \
    --disable-libobjc \
    --disable-libphobos \
    --disable-libquadmath \
    --disable-libsanitizer \
    --disable-libssp \
    --disable-libstdcxx \
    --disable-libvtv \
    --with-gmp=/usr \
    --with-isl=/usr \
    --with-mpc=/usr \
    --with-mpfr=/usr \
    --with-system-zlib

  make MAKEINFO=true all-gcc all-target-libgcc
  make -C "${srcdir}/${_build_dir}/${_target}/libgcc" \
    enable_shared=yes libgcc_eh.a

  _install_compiler "${srcdir}/${_stage_dir}"
  _install_runtime "${srcdir}/${_stage_dir}"

  bash "${srcdir}/validate-static-runtime.sh" \
    "${srcdir}/${_stage_dir}/opt" \
    "${srcdir}/${_report_dir}" \
    "${srcdir}/${_build_dir}" \
    "${srcdir}/${_source_dir}" \
    "${srcdir}/${_runtime_dir}" \
    "${srcdir}/runtime-build-${_target}" \
    "${srcdir}"
}

_install_compiler() {
  local _root=$1

  cd "${srcdir}/${_build_dir}"
  make MAKEINFO=true DESTDIR="${_root}" install-gcc install-lto-plugin

  rm -rf \
    "${_root}/opt/include" \
    "${_root}/opt/lib/bfd-plugins" \
    "${_root}/opt/share"
  rm -f \
    "${_root}/opt/lib/libiberty.a" \
    "${_root}/opt/bin/${_target}-lto-dump.exe" \
    "${_root}/opt/bin/${_target}-gcov.exe" \
    "${_root}/opt/bin/${_target}-gcov-dump.exe" \
    "${_root}/opt/bin/${_target}-gcov-tool.exe"
  rm -f "${_root}/opt/bin/${_target}-${_target}-"*.exe
  rm -rf \
    "${_root}/opt/lib/gcc/${_target}/${_gcc_version}/install-tools" \
    "${_root}/opt/libexec/gcc/${_target}/${_gcc_version}/install-tools"
  install -m644 \
    "${srcdir}/${_source_dir}/libgcc/gcov.h" \
    "${_root}/opt/lib/gcc/${_target}/${_gcc_version}/include/"

  find "${_root}/opt" -type f \( -name '*.exe' -o -name '*.dll' \) \
    -exec strip --strip-unneeded {} +
}

_install_runtime() {
  local _root=$1
  local _libdir="${_root}/opt/lib/gcc/${_target}/${_gcc_version}"
  local _build_libdir="${srcdir}/${_build_dir}/${_target}/libgcc"

  install -d "${_libdir}"
  install -m644 \
    "${_build_libdir}/libgcc.a" \
    "${_build_libdir}/libgcc_eh.a" \
    "${_build_libdir}/libgcov.a" \
    "${_build_libdir}/crtbegin.o" \
    "${_build_libdir}/crtbeginS.o" \
    "${_build_libdir}/crtend.o" \
    "${_build_libdir}/crtfastmath.o" \
    "${_libdir}/"
}

check() {
  local _log="${srcdir}/${_report_dir}/dejagnu-cygming-unprioritized-cdtor.log"
  local _sum="${srcdir}/${_report_dir}/dejagnu-cygming-unprioritized-cdtor.sum"

  make -C "${srcdir}/${_build_dir}" gcc-site.exp
  (
    cd "${srcdir}/${_build_dir}/gcc"
    rm -f gcc.log gcc.sum
    env -u MAKEFLAGS -u MFLAGS timeout 600s runtest \
      --tool gcc \
      --srcdir="${srcdir}/${_source_dir}/gcc/testsuite" \
      aarch64.exp=cygming-unprioritized-cdtor.c
  ) 2>&1 | tee "${_log}"
  cp "${srcdir}/${_build_dir}/gcc/gcc.sum" "${_sum}"
  grep -Eq '^# of expected passes[[:space:]]+5$' "${_sum}"
  if grep -Eq '^(FAIL|UNRESOLVED|XPASS):|^# of unexpected|^# of unresolved' \
      "${_sum}"; then
    return 1
  fi
  sed -E -i \
    -e "s#${srcdir}#<srcdir>#g" \
    -e 's/^Test run by .* on .*/Test run normalized/' \
    "${_log}" "${_sum}"
}

package_mingw-w64-cross-cygwinarm64-gcc-stage1() {
  pkgdesc="C, C++, and LTO compiler for the aarch64-pc-cygwin static runtime stage"
  depends=('gmp' 'isl' 'libiconv' 'libintl' 'libzstd' 'mpc' 'mpfr' 'zlib'
           "mingw-w64-cross-cygwinarm64-binutils>=2.44.50"
           'mingw-w64-cross-cygwinarm64-libstdc++-headers=15.0.1dev-1'
           "mingw-w64-cross-cygwinarm64-gcc-libs-stage1=${pkgver}-${pkgrel}")
  provides=("aarch64-pc-cygwin-gcc-stage1=${pkgver}"
            "mingw-w64-cross-cygwin-arm64-gcc-stage1=${pkgver}"
            "mingw-w64-cross-cygwinarm64-gcc-stage1=15.0.1dev-1")
  conflicts=('aarch64-pc-cygwin-gcc-stage1'
             'mingw-w64-cross-cygwin-arm64-gcc-stage1')

  _install_compiler "${pkgdir}"

  local _licensedir="${pkgdir}/opt/share/licenses/${pkgname}"
  install -d "${_licensedir}"
  install -m644 \
    "${srcdir}/${_source_dir}/COPYING3" \
    "${srcdir}/${_source_dir}/COPYING.RUNTIME" \
    "${_licensedir}/"
}

package_mingw-w64-cross-cygwinarm64-gcc-libs-stage1() {
  pkgdesc="Static GCC runtime and startup objects for aarch64-pc-cygwin"
  depends=("mingw-w64-cross-cygwinarm64-binutils>=2.44.50"
           'mingw-w64-cross-cygwinarm64-headers=3.6.10.r0.gee50e0223-1'
           'mingw-w64-cross-cygwinarm64-sysroot=3.6.10.r0.gee50e0223-1'
           'mingw-w64-cross-cygwinarm64-w32api-runtime=14.0.0.r0.g9b3dd0125-1'
           'mingw-w64-cross-cygwinarm64-windows-default-manifest=3.6.10.r0.gee50e0223-1')
  provides=("aarch64-pc-cygwin-gcc-libs=${pkgver}"
            "aarch64-pc-cygwin-gcc-static-runtime=${pkgver}")
  conflicts=('aarch64-pc-cygwin-gcc-libs'
             'aarch64-pc-cygwin-gcc-static-runtime'
             'mingw-w64-cross-cygwin-arm64-gcc-libs-stage1')

  _install_runtime "${pkgdir}"

  local _docdir="${pkgdir}/opt/share/doc/${pkgname}"
  local _licensedir="${pkgdir}/opt/share/licenses/${pkgname}"
  install -d "${_docdir}" "${_licensedir}"
  cp -a "${srcdir}/${_report_dir}/." "${_docdir}/"
  install -m644 \
    "${srcdir}/README.static-runtime.md" \
    "${srcdir}/abi.c" \
    "${srcdir}/ctor-order.c" \
    "${srcdir}/cxa-order.cc" \
    "${srcdir}/lto-gc.c" \
    "${srcdir}/unwind.c" \
    "${_docdir}/"
  install -m755 \
    "${srcdir}/validate-static-runtime.sh" \
    "${_docdir}/"
  install -m644 \
    "${srcdir}/${_source_dir}/COPYING3" \
    "${srcdir}/${_source_dir}/COPYING.RUNTIME" \
    "${_licensedir}/"
}
