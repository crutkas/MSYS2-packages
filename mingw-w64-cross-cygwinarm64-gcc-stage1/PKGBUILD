_realname=gcc
_target=aarch64-pc-cygwin
_host=x86_64-pc-msys
_source_commit=bd1d77ba35e2820df5387cca5213925adb07a0ee
_gcc_version=15.0.1
export SOURCE_DATE_EPOCH=1786669894
pkgname=mingw-w64-cross-cygwinarm64-${_realname}-stage1
pkgver=15.0.1dev
pkgrel=1
pkgdesc="Stage-0/no-headers GCC for an x86_64 MSYS host and aarch64-pc-cygwin target"
arch=('x86_64')
url="https://github.com/crutkas/gcc-woarm64"
msys2_repository_url="https://github.com/crutkas/gcc-woarm64"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later' 'GFDL-1.3-or-later')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
depends=('gmp' 'isl' 'libiconv' 'libintl' 'libzstd' 'mpc' 'mpfr' 'zlib'
         "mingw-w64-cross-cygwinarm64-binutils>=2.44.50")
makedepends=('gcc' 'gmp-devel' 'isl-devel' 'libiconv-devel' 'libzstd-devel'
             'make' 'mpc-devel' 'mpfr-devel' 'python' 'zlib-devel')
provides=("aarch64-pc-cygwin-gcc-stage1=${pkgver}"
          "mingw-w64-cross-cygwin-arm64-gcc-stage1=${pkgver}")
conflicts=('aarch64-pc-cygwin-gcc-stage1'
           'mingw-w64-cross-cygwin-arm64-gcc-stage1')
options=('staticlibs' '!distcc' '!ccache' '!buildflags' '!strip')
source=("${_realname}-${_source_commit}.tar.gz::https://github.com/crutkas/gcc-woarm64/archive/${_source_commit}.tar.gz"
        README.stage0.md
        abi.c
        newlib-fragment.c
        register-pressure.c
        sysroot-fragment.c
        sysroot-fragment.cc
        tls.c
        unwind.c
        validate-stage0.sh
        validate-sysroot.sh
        winsup-fragment.cc)
