_realname=gcc
_target=aarch64-pc-cygwin
_host=x86_64-pc-msys
_source_commit=e1a057af466f066d86b20270fb7864764951420d
_runtime_commit=a29cc9938c0d8d31d7ac1fc1a286cfa17f1df90c
_gcc_version=15.0.1
export SOURCE_DATE_EPOCH=1786817435
pkgbase=mingw-w64-cross-cygwinarm64-${_realname}-stage1
pkgname=(
  mingw-w64-cross-cygwinarm64-${_realname}-stage1
  mingw-w64-cross-cygwinarm64-${_realname}-libs-stage1
)
pkgver=15.0.1dev
pkgrel=2
pkgdesc="Headers-enabled static GCC stage for an x86_64 MSYS host and aarch64-pc-cygwin target"
arch=('x86_64')
url="https://github.com/crutkas/gcc-woarm64"
msys2_repository_url="https://github.com/crutkas/gcc-woarm64"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later' 'GFDL-1.3-or-later')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
makedepends=('autoconf' 'automake' 'gcc' 'gmp-devel' 'isl-devel'
             'libiconv-devel' 'libzstd-devel'
             'make'
             'mingw-w64-cross-cygwinarm64-binutils>=2.44.50'
             'mingw-w64-cross-cygwinarm64-headers=3.6.10.r0.gee50e0223-1'
             'mingw-w64-cross-cygwinarm64-libstdc++-headers=15.0.1dev-1'
             'mingw-w64-cross-cygwinarm64-sysroot=3.6.10.r0.gee50e0223-1'
             'mingw-w64-cross-cygwinarm64-w32api-runtime=14.0.0.r0.g9b3dd0125-1'
             'mingw-w64-cross-cygwinarm64-windows-default-manifest=3.6.10.r0.gee50e0223-1'
             'mpc-devel' 'mpfr-devel' 'python' 'zlib-devel')
checkdepends=('dejagnu')
options=('staticlibs' '!distcc' '!ccache' '!buildflags' '!strip' '!emptydirs')
source=("${_realname}-${_source_commit}.tar.gz::https://github.com/crutkas/gcc-woarm64/archive/${_source_commit}.tar.gz"
        "msys2-runtime-${_runtime_commit}.tar.gz::https://github.com/crutkas/msys2-runtime/archive/${_runtime_commit}.tar.gz"
        README.static-runtime.md
        abi.c
        ctor-order.c
        cxa-order.cc
        lto-gc.c
        unwind.c
        validate-static-runtime.sh)
sha256sums=('8194893d7093f3cadedc2ec42375ffbbc02a22e30d943e5f1c1aefa273af8122'
            'e53b4ce39430398fe6edb515c99e9bb0a37d2d36aedf146ce8f49c87ca7f5819'
            '91e186e162d680fa11f3796ed1aef09d55f1ac78d951bbbc0b14279d93067ed9'
