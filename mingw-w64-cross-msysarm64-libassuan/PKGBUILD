# Maintainer: Chris Reddington <crutkas@microsoft.com>

_realname=libassuan
_target=aarch64-pc-msys
_runtime_version=3.6.10.r0.ga527ace21
_runtime_pkgrel=1
_gcc_version=15.0.1dev
_gcc_pkgrel=1
_libgpg_error_version=1.55
_libgpg_error_pkgrel=1

# The a527 runtime is immutable. Candidate packages remain provisional until
# rebuilt with the coordinator-approved fixed binutils and native ARM64 passes.
pkgbase=mingw-w64-cross-msysarm64-libassuan
pkgname=(
  mingw-w64-cross-msysarm64-libassuan
  mingw-w64-cross-msysarm64-libassuan-devel
  mingw-w64-cross-msysarm64-libassuan-tools
)
pkgver=3.0.2
pkgrel=1
pkgdesc="ARM64 MSYS IPC library for GnuPG components"
arch=('x86_64')
url="https://gnupg.org/related_software/libassuan"
msys2_repository_url="https://git.gnupg.org/cgi-bin/gitweb.cgi?p=libassuan.git"
msys2_pgp_keys_url="https://gnupg.org/signature_key.html"
license=('spdx:LGPL-2.1-or-later' 'spdx:GPL-3.0-or-later')
makedepends=(
  'autotools'
  'gcc'
  'pkgconf'
  'mingw-w64-cross-cygwinarm64-binutils>=2.44.50'
  "mingw-w64-cross-msysarm64-gcc=${_gcc_version}-${_gcc_pkgrel}"
  "mingw-w64-cross-msysarm64-gcc-libs=${_gcc_version}-${_gcc_pkgrel}"
  "mingw-w64-cross-msysarm64-runtime-devel=${_runtime_version}-${_runtime_pkgrel}"
  "mingw-w64-cross-msysarm64-sysroot=${_runtime_version}-${_runtime_pkgrel}"
  "mingw-w64-cross-msysarm64-libgpg-error=${_libgpg_error_version}-${_libgpg_error_pkgrel}"
  "mingw-w64-cross-msysarm64-libgpg-error-devel=${_libgpg_error_version}-${_libgpg_error_pkgrel}"
)
options=('!strip' '!buildflags' '!emptydirs' 'libtool')
source=(
  "https://gnupg.org/ftp/gcrypt/${_realname}/${_realname}-${pkgver}.tar.bz2"{,.sig}
  audit-msysarm64.sh
  context-smoke.c
  pipe-smoke.c
)
sha256sums=('d2931cdad266e633510f9970e1a2f346055e351bb19f9b78912475b8074c36f6'
            'SKIP'
            '1b6576327dc2c3b93690948d01373c0e9f85c095ef3e07f877329bbaa4608c37'
            'a2851e6e30ce02a7ecce214006e6def5bc61689d51087ae6e59d4803fb86d400'
            '2142faf66e8bc82dbb8ba08d52bc8a2a25f5844cdd5baa6e366ba2d8772625ae')
validpgpkeys=('6DAA6E64A76D2840571B4902528897B826403ADA'
              'AC8E115BF73E2D8D47FA9908E98E9B2D19C6C8BD')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  # MSYS uses the Cygwin libtool model while retaining its own target triplet.
  perl -0pi -e 's/\*-\*-cygwin\*\)/\*-\*-cygwin* | *-*-msys*)/' configure.ac
  autoreconf -fi
  perl -0pi -e 's/cygwin\* \| mingw\* \| windows\* \| pw32\* \| cegcc\*/cygwin* | msys* | mingw* | windows* | pw32* | cegcc*/g; s/cygwin\*\)/cygwin* | msys*)/g' m4/libtool.m4 configure
}

build() {
  cd "${srcdir}/${_realname}-${pkgver}"

  local _build_triplet
  _build_triplet="$(gcc -dumpmachine)"

  export PATH="/opt/${_target}/usr/bin:/opt/bin:${PATH}"
  export PKG_CONFIG_SYSROOT_DIR="/opt/${_target}"
  export PKG_CONFIG_LIBDIR="/opt/${_target}/usr/lib/pkgconfig"
  export GPGRT_CONFIG=no
  export GPG_ERROR_CONFIG="/opt/${_target}/usr/bin/gpg-error-config"
  export lt_cv_deplibs_check_method=pass_all

  ./configure \
    CC="${_target}-gcc" \
    AR="${_target}-ar" \
    RANLIB="${_target}-ranlib" \
    LD="${_target}-ld" \
    NM="${_target}-nm" \
    STRIP="${_target}-strip" \
    DLLTOOL="${_target}-dlltool" \
    WINDRES="${_target}-windres" \
    CC_FOR_BUILD=gcc \
    --prefix=/usr \
    --build="${_build_triplet}" \
    --host="${_target}" \
    --with-libgpg-error-prefix="/opt/${_target}/usr" \
    --enable-shared \
    --enable-static

  make no_undefined="-no-undefined"
  make DESTDIR="${srcdir}/dest" install
  sed -i "s|/opt/${_target}/usr|/usr|g" \
    "${srcdir}/dest/usr/bin/libassuan-config" \
    "${srcdir}/dest/usr/lib/libassuan.la"
}

check() {
  "${srcdir}/audit-msysarm64.sh" \
    "${srcdir}/dest" \
    "${srcdir}/audit-report" \
    "${srcdir}/context-smoke.c" \
    "${srcdir}/pipe-smoke.c" \
    "/opt/${_target}" \
    "${srcdir}/${_realname}-${pkgver}/src/libassuan.vers"
}

package_mingw-w64-cross-msysarm64-libassuan() {
  pkgdesc="ARM64 MSYS libassuan runtime library"
  groups=('libraries')
  depends=(
    "aarch64-pc-msys-runtime=${_runtime_version}"
    "aarch64-pc-msys-libgpg-error=${_libgpg_error_version}"
  )
  provides=("aarch64-pc-msys-libassuan=${pkgver}")
  conflicts=('aarch64-pc-msys-libassuan')

  install -d "${pkgdir}/opt/${_target}/usr/bin"
  install -m755 "${srcdir}/dest/usr/bin/"*.dll \
    "${pkgdir}/opt/${_target}/usr/bin/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}

package_mingw-w64-cross-msysarm64-libassuan-devel() {
  pkgdesc="ARM64 MSYS libassuan headers and libraries"
  groups=('development')
  depends=(
    "aarch64-pc-msys-libassuan=${pkgver}"
    "aarch64-pc-msys-libgpg-error-devel=${_libgpg_error_version}"
  )
  provides=("aarch64-pc-msys-libassuan-devel=${pkgver}")
  conflicts=('aarch64-pc-msys-libassuan-devel')
  options=('staticlibs' 'libtool')

  install -d "${pkgdir}/opt/${_target}/usr/share"
  cp -a "${srcdir}/dest/usr/include" "${pkgdir}/opt/${_target}/usr/"
  cp -a "${srcdir}/dest/usr/lib" "${pkgdir}/opt/${_target}/usr/"
  cp -a "${srcdir}/dest/usr/share/aclocal" "${pkgdir}/opt/${_target}/usr/share/"
  cp -a "${srcdir}/dest/usr/share/info" "${pkgdir}/opt/${_target}/usr/share/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}

package_mingw-w64-cross-msysarm64-libassuan-tools() {
  pkgdesc="ARM64 MSYS libassuan development helper"
  depends=(
    'sh'
    "aarch64-pc-msys-libassuan-devel=${pkgver}"
  )
  provides=("aarch64-pc-msys-libassuan-tools=${pkgver}")
  conflicts=('aarch64-pc-msys-libassuan-tools')

  install -Dm755 "${srcdir}/dest/usr/bin/libassuan-config" \
    "${pkgdir}/opt/${_target}/usr/bin/libassuan-config"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING.LIB" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
}
