_realname=bzip2
_target=aarch64-pc-msys
_runtime_version=3.6.10.r0.ga527ace21
_runtime_pkgrel=1
_runtime_release_tag=msysarm64-runtime-pr10-a527-20260824
_sysroot_version=3.6.10.r0.ga527ace21
_sysroot_pkgrel=1
_w32api_version=14.0.0.r0.g9b3dd0125
_gcc_version=15.0.1dev
_gcc_pkgrel=1
_gcc_release_tag=msysarm64-gcc-pr13-20260826
_support_release_tag=msysarm64-gcc-pr13-support-20260826
_binutils_version=2.44.50
_binutils_pkgrel=2
_binutils_release_tag=cygwinarm64-binutils-pr21-3356eec-20260827
_binutils_sha256=3c7b47529181dab726d22cf6ed045184260af915eea583488c13c07e478ac02b
_binutils_linker_sha256=075ed377a430eb120a994dfdc7c3187e937331239204578d696f08ee1c72fb1f
_binutils_producer_head=3356eec1411983cc252b04afac32bca5f3b8d824
_binutils_producer_run=33044771291
_pseudo_reloc_scanner_sha256=888939b57d1bce2e3c119e7c4824703e893bd449d49a5142f040dd935741ddb9

pkgbase=mingw-w64-cross-msysarm64-bzip2
pkgname=(
  mingw-w64-cross-msysarm64-bzip2
  mingw-w64-cross-msysarm64-libbz2
  mingw-w64-cross-msysarm64-libbz2-devel
)
pkgver=1.0.8
pkgrel=4
pkgdesc="bzip2 compression tools and library for aarch64-pc-msys"
arch=('x86_64')
url="https://sourceware.org/bzip2/"
msys2_repository_url="https://sourceware.org/git/bzip2.git"
msys2_references=(
  "cpe: cpe:/a:bzip:bzip2"
)
license=('spdx:bzip2-1.0.6')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
makedepends=(
  'make'
  'patch'
  "mingw-w64-cross-cygwinarm64-binutils=${_binutils_version}-${_binutils_pkgrel}"
  "mingw-w64-cross-msysarm64-gcc=${_gcc_version}-${_gcc_pkgrel}"
  "mingw-w64-cross-msysarm64-gcc-libs=${_gcc_version}-${_gcc_pkgrel}"
  "mingw-w64-cross-msysarm64-runtime-devel=${_runtime_version}-${_runtime_pkgrel}"
  "mingw-w64-cross-msysarm64-sysroot=${_sysroot_version}-${_sysroot_pkgrel}"
  "mingw-w64-cross-msysarm64-w32api-runtime=${_w32api_version}-1"
)
options=('!strip' '!buildflags' '!emptydirs')
source=(
  "https://sourceware.org/pub/bzip2/${_realname}-${pkgver}.tar.gz"{,.sig}
  "https://sourceware.org/pub/bzip2/gpgkey-5C1D1AA44BE649DE760A.gpg"
  bzip2-1.0.6-msys-dll.patch
  bzip2-1.0.6-msys2.patch
  bzip2.pc
  native-consumer.c
  validate-bzip2.sh
  README.md
)
sha256sums=(
  'ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269'
  'c667e2db9a3cd17bde492584263cb7c30d8050538678ece3078ae58230e6e5e1'
  '3a189df1faa883973d80f1fc6d7450affddbf35989427692a6bf90e48b7466ad'
  'a14e3ef3108fe843f5bd4bdf0943cc22c0a1581c382706dbd3f42ad7dc097c88'
  'b499532b538ae1faa9b07933013671fd8f34431bfaa802f9099a96a6a4135e80'
  'c326365ff8835fdf2d8c8b41f65b594879fa8d69ca869d813a8cba7288d8bc1f'
  '9e4da2a8f477de3dfa761cd0921fcbaf7c0924699a01d30ffc7cdbba1fd54183'
  'c4f4f3cdf438bb37c3f5cfbca4831b4f205610c4f8eb9c6e64f4b6f1082f93d8'
  '0ca3b974bc47715ad3014adeb75d8a98d17182d4f9420624324d00f5f50ca5e0'
