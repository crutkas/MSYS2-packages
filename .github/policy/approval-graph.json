{
  "version": 3,
  "repository": {
    "full_name": "crutkas/MSYS2-packages",
    "id": 1333319488,
    "api_url": "https://api.github.com",
    "html_url": "https://github.com/crutkas/MSYS2-packages",
    "default_branch": "master",
    "required_check": "workflow-policy / verify",
    "required_workflow": ".github/workflows/workflow-policy.yml",
    "required_workflow_ref": "refs/heads/master",
    "github_actions_integration_id": 15368,
    "dedicated_check": {
      "context": "workflow-policy / anchored-admission",
      "integration_id": null
    }
  },
  "bootstrap": {
    "base_policy_absent": true,
    "self_admission": "denied",
    "source_admission": "required",
    "rules_activation": "required-after-landing"
  },
  "approved_actions": {
    "actions/checkout": "11d5960a326750d5838078e36cf38b85af677262"
  },
  "workflows": {
    ".github/workflows/workflow-policy.yml": {
      "blob": "9e488832cfaa3ba937f3c99216d2969d96ae7060",
      "name": "workflow-policy",
      "events": [
        "pull_request_target"
      ],
      "event_types": {
        "pull_request_target": [
          "opened",
          "synchronize",
          "reopened",
          "ready_for_review"
        ]
      },
      "event_branches": {
        "pull_request_target": [
          "master"
        ]
      },
      "protected_branch": "master",
      "permissions": {
        "contents": "read"
      },
      "fork_execution": "base-only-data-validation",
      "jobs": {
        "verify": {
          "name": "workflow-policy / verify",
          "runs_on": "windows-2025",
          "steps": [
            {
              "name": "Check out protected base",
              "kind": "action",
              "action": "actions/checkout",
              "with": {
                "ref": "${{ github.event.pull_request.base.sha }}",
                "path": "protected-base",
                "fetch-depth": 1,
                "persist-credentials": false,
                "clean": true
              }
            },
            {
              "name": "Verify protected base and create private root",
              "kind": "run",
              "run_sha256": "741e997f4fc1390ce82af812566564333080ff457848f12031f54a88e20977af",
              "env": {
                "POLICY_REPOSITORY": "${{ github.repository }}",
                "POLICY_REPOSITORY_ID": "${{ github.repository_id }}",
                "POLICY_BASE_SHA": "${{ github.event.pull_request.base.sha }}",
                "POLICY_BASE_REF": "${{ github.event.pull_request.base.ref }}",
                "POLICY_RUN_ID": "${{ github.run_id }}",
                "POLICY_RUN_ATTEMPT": "${{ github.run_attempt }}",
                "POLICY_JOB": "${{ github.job }}",
                "POLICY_MATRIX": "none"
              }
            },
            {
              "name": "Validate candidate as inert data",
              "kind": "run",
              "github_token": true,
              "run_sha256": "1eb9d1708938da14faf3c78ff89d285f5ba7f57edbb33f8f8385a90da3c590b7",
              "env": {
                "POLICY_GITHUB_TOKEN": "${{ github.token }}",
                "POLICY_API_URL": "${{ github.api_url }}",
                "POLICY_REPOSITORY": "${{ github.repository }}",
                "POLICY_BASE_SHA": "${{ github.event.pull_request.base.sha }}"
              }
            }
          ]
        }
      },
      "helpers": [
        ".github/policy/private-root.ps1",
        ".github/policy/validator.py"
      ],
      "data": [
        ".github/policy/approval-graph.json"
      ]
    }
  },
  "helpers": {
    ".github/policy/private-root.ps1": {
      "blob": "07532887403cb8b60eaa86017034125d6962d4a4",
      "mode": "100644",
      "interpreter": "pwsh",
      "capabilities": [],
      "dependencies": [
        ".github/policy/PrivateRoot.psm1"
      ],
      "consumers": [
        ".github/workflows/workflow-policy.yml"
      ]
    },
    ".github/policy/PrivateRoot.psm1": {
