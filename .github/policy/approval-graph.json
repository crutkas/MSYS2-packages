      "mode": "100644",
      "interpreter": "pwsh-module",
      "capabilities": [
        "git-read-local"
      ],
      "dependencies": [],
      "consumers": [
        ".github/policy/private-root.ps1"
      ]
    },
    ".github/policy/validator.py": {
      "blob": "0f3db65940592ecb547ad0fe10ba711580de6a12",
      "mode": "100644",
      "interpreter": "python",
      "capabilities": [
        "github-api-read",
