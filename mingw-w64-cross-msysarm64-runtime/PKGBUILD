# Maintainer: Chris Reddington <crutkas@microsoft.com>

_runtime_commit=6922c388be93e423c1186f0b58c39380a5ee9e2d
_runtime_root=msys2-runtime-${_runtime_commit}
_build_target=aarch64-pc-cygwin
_install_target=aarch64-pc-msys
_sysroot_version=3.6.10.r0.g6922c388b
_sysroot_pkgrel=1

pkgbase=mingw-w64-cross-msysarm64-runtime
pkgname=(
  mingw-w64-cross-msysarm64-runtime
  mingw-w64-cross-msysarm64-runtime-devel
)
pkgver=3.6.10.r0.g6922c388b
pkgrel=1
pkgdesc="Source-built ARM64 MSYS runtime for aarch64-pc-msys"
arch=('x86_64')
url="https://github.com/crutkas/msys2-runtime"
msys2_repository_url="https://github.com/crutkas/msys2-runtime"
license=('GPL' 'LGPL' 'custom')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
makedepends=(
  'autotools'
  'cocom'
  'docbook-xsl'
  'gcc'
  'gettext-devel'
  'git'
  'libiconv-devel'
  'mingw-w64-cross-cygwinarm64-binutils'
  'mingw-w64-cross-cygwinarm64-gcc-stage1'
  'mingw-w64-cross-msysarm64-libstdc++-headers'
  'mingw-w64-cross-msysarm64-sysroot'
  'mingw-w64-cross-msysarm64-w32api-runtime'
  'perl'
  'xmlto'
  'zlib-devel'
)
options=('!strip' '!buildflags' '!emptydirs')
source=(
  "msys2-runtime-${_runtime_commit}.tar.gz::https://github.com/crutkas/msys2-runtime/archive/${_runtime_commit}.tar.gz"
  'README.md'
)
sha256sums=(
  'f9a6bd4366802d05d43b7c3876fceb92b93b89b172eebb020d48d2fb36389f89'
  'a7cf07ea3326026eebdd5091cea25ac6a89f607e43afe623594cf22c6faa8794'
)

build() {
  local build_dir="${srcdir}/build-${_build_target}"
  local _w32api_include="-I/opt/${_install_target}/include/w32api"
  export PATH="/opt/bin:${PATH}"
  export SOURCE_DATE_EPOCH="$(git -C "${startdir}" show -s --format=%ct HEAD)"
  export CPPFLAGS_FOR_TARGET="${CPPFLAGS_FOR_TARGET} ${_w32api_include}"
  export CFLAGS_FOR_TARGET="${CFLAGS_FOR_TARGET} ${_w32api_include}"
  export CXXFLAGS_FOR_TARGET="${CXXFLAGS_FOR_TARGET} ${_w32api_include}"
  export ac_cv_lib_sframe_sframe_decode=no
  export ac_cv_lib_zstd_ZSTD_isError=no

  (cd "${srcdir}/${_runtime_root}/winsup" && ./autogen.sh)

  rm -rf "${build_dir}"
  mkdir -p "${build_dir}"
  (
    cd "${build_dir}"
    "${srcdir}/${_runtime_root}/configure" \
        --target="${_build_target}" \
        --prefix="${build_dir}/install" \
        --disable-doc \
        --with-cross-bootstrap \
        --with-msys2-runtime-commit="${_runtime_commit}" \
        CFLAGS_FOR_TARGET='-O2 -g -D__MSYS__' \
        CXXFLAGS_FOR_TARGET='-O2 -g -D__MSYS__'
  )

  make -C "${build_dir}" -j"$(nproc)" all-target-newlib
  make -C "${build_dir}" configure-target-winsup
  make -C "${build_dir}/${_build_target}/winsup/cygwin" -j"$(nproc)"
}

check() {
  local build_dir="${srcdir}/build-${_build_target}"
  local cygwin_dir="${build_dir}/${_build_target}/winsup/cygwin"
  local newlib_dir="${build_dir}/${_build_target}/newlib"
  local report_dir="${build_dir}/validation"
  local ar="${_build_target}-ar"
  export PATH="/opt/bin:${PATH}"

  rm -rf "${report_dir}"
  mkdir -p "${report_dir}"

  "${srcdir}/${_runtime_root}/.github/checks/validate-aarch64-runtime.sh" \
    "${build_dir}" \
    "${report_dir}"

  test -f "${newlib_dir}/libg.a"
  test -f "${cygwin_dir}/libgmon.a"
  test -f "${newlib_dir}/libc.a"
  diff -u <("${ar}" t "${newlib_dir}/libc.a") \
    <("${ar}" t "${newlib_dir}/libg.a")

  for target_file in \
    /opt/${_install_target}/bin/msys-2.0.dll \
    /opt/${_install_target}/lib/crt0.o \
    /opt/${_install_target}/lib/gcrt0.o \
    /opt/${_install_target}/lib/libaio.a \
    /opt/${_install_target}/lib/libacl.a \
    /opt/${_install_target}/lib/libc.a \
    /opt/${_install_target}/lib/libdl.a \
    /opt/${_install_target}/lib/libg.a \
    /opt/${_install_target}/lib/libgmon.a \
    /opt/${_install_target}/lib/libmsys-2.0.a \
    /opt/${_install_target}/lib/libpthread.a \
    /opt/${_install_target}/lib/libresolv.a \
    /opt/${_install_target}/lib/librt.a \
    /opt/${_install_target}/lib/libssp.a \
    /opt/${_install_target}/lib/libutil.a
  do
    if owner=$(pacman -Qoq "${target_file}" 2>/dev/null); then
      echo "ownership collision for ${target_file}: ${owner}" >&2
      exit 1
    fi
  done
}

package_mingw-w64-cross-msysarm64-runtime() {
  local build_dir="${srcdir}/build-${_build_target}"
  local cygwin_dir="${build_dir}/${_build_target}/winsup/cygwin"
  local pkgroot="${pkgdir}/opt/${_install_target}"
  local license_dir="${pkgdir}/usr/share/licenses/${pkgname}"

  pkgdesc="MSYS runtime DLL for aarch64-pc-msys"
  provides=("aarch64-pc-msys-runtime=${pkgver}")
  conflicts=('aarch64-pc-msys-runtime')
  depends=("mingw-w64-cross-msysarm64-sysroot=${_sysroot_version}-${_sysroot_pkgrel}")

  install -Dm755 "${cygwin_dir}/new-msys-2.0.dll" \
    "${pkgroot}/bin/msys-2.0.dll"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING" "${license_dir}/COPYING"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIB" "${license_dir}/COPYING.LIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.NEWLIB" "${license_dir}/COPYING.NEWLIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIBGLOSS" "${license_dir}/COPYING.LIBGLOSS"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3" "${license_dir}/COPYING3"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3.LIB" "${license_dir}/COPYING3.LIB"
}

package_mingw-w64-cross-msysarm64-runtime-devel() {
  local build_dir="${srcdir}/build-${_build_target}"
  local cygwin_dir="${build_dir}/${_build_target}/winsup/cygwin"
  local newlib_dir="${build_dir}/${_build_target}/newlib"
  local cygserver_dir="${build_dir}/${_build_target}/winsup/cygserver"
  local pkgroot="${pkgdir}/opt/${_install_target}"
  local libdir="${pkgroot}/lib"
  local license_dir="${pkgdir}/usr/share/licenses/${pkgname}"

  pkgdesc="MSYS runtime libraries and startup objects for aarch64-pc-msys"
  depends=(
    "mingw-w64-cross-msysarm64-runtime=${pkgver}-${pkgrel}"
    "mingw-w64-cross-msysarm64-sysroot=${_sysroot_version}-${_sysroot_pkgrel}"
  )
  provides=("aarch64-pc-msys-runtime-devel=${pkgver}")
  conflicts=('aarch64-pc-msys-runtime-devel')
  options=('!strip')

  install -d "${libdir}"

  for file in \
    crt0.o \
    gcrt0.o \
    libaio.a \
    libacl.a \
    libdl.a \
    libgmon.a \
    libg.a \
    libmsys-2.0.a \
    libpthread.a \
    libresolv.a \
    librt.a \
    libssp.a \
    libutil.a
  do
    case "${file}" in
      libg.a)
        src="${newlib_dir}/${file}"
        ;;
      *)
        src="${cygwin_dir}/${file}"
        ;;
    esac
    test -f "${src}"
    install -Dm644 "${src}" "${libdir}/${file}"
  done

  install -Dm644 "${cygserver_dir}/libcygserver.a" \
    "${libdir}/libcygserver.a"

  # Keep the newlib target archives authoritative and package only the
  # source-built runtime layer; headers remain owned by the sysroot package.
  install -Dm644 "${newlib_dir}/libc.a" "${libdir}/libc.a"
  install -Dm644 "${newlib_dir}/libm.a" "${libdir}/libm.a"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING" "${license_dir}/COPYING"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIB" "${license_dir}/COPYING.LIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.NEWLIB" "${license_dir}/COPYING.NEWLIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIBGLOSS" "${license_dir}/COPYING.LIBGLOSS"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3" "${license_dir}/COPYING3"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3.LIB" "${license_dir}/COPYING3.LIB"
}
