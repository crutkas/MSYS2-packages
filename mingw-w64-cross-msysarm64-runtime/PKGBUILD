_runtime_commit=c7932d64f13d51deacdcbfdab8df79bcb35ebd92
_runtime_root=msys2-runtime-${_runtime_commit}
_build_target=aarch64-pc-cygwin
_install_target=aarch64-pc-msys
_sysroot_version=3.6.10.r0.gc7932d64f
_sysroot_pkgrel=1

pkgbase=mingw-w64-cross-msysarm64-runtime
pkgname=(
  mingw-w64-cross-msysarm64-runtime
  mingw-w64-cross-msysarm64-runtime-devel
)
pkgver=3.6.10.r0.gc7932d64f
pkgrel=1
pkgdesc="Source-built ARM64 MSYS runtime for aarch64-pc-msys"
arch=('x86_64')
url="https://github.com/crutkas/msys2-runtime"
msys2_repository_url="https://github.com/crutkas/msys2-runtime"
license=('GPL' 'LGPL' 'custom')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
makedepends=(
  'autotools'
  'cocom'
  'docbook-xsl'
  'gcc'
  'gettext-devel'
  'git'
  'libiconv-devel'
  'mingw-w64-cross-cygwinarm64-binutils'
  'mingw-w64-cross-cygwinarm64-gcc-stage1'
  'mingw-w64-cross-cygwinarm64-gcc-libs-stage1'
  'mingw-w64-cross-msysarm64-libstdc++-headers'
  'mingw-w64-cross-msysarm64-sysroot'
  'mingw-w64-cross-msysarm64-w32api-runtime'
  'perl'
  'xmlto'
  'zlib-devel'
)
options=('!strip' '!buildflags' '!emptydirs')
source=(
  "msys2-runtime-${_runtime_commit}.tar.gz::https://github.com/crutkas/msys2-runtime/archive/${_runtime_commit}.tar.gz"
  'README.md'
)
sha256sums=(
  'a21c55ad56fd60e24739497cbcfbce0ca77094c0f42b35818ee43e886c093e0c'
  'a7cf07ea3326026eebdd5091cea25ac6a89f607e43afe623594cf22c6faa8794'
)

build() {
  local build_dir="${srcdir}/build-${_build_target}"
  local _target_include="/opt/${_install_target}/include"
  local _target_w32api="${_target_include}/w32api"
  local _target_cxx_include="${_target_include}/c++/15.0.1"
  local _target_cxx_specific="${_target_cxx_include}/${_install_target}"
  local _target_cxx_backward="${_target_cxx_include}/backward"
  local _runtime_source_include="-I${srcdir}/${_runtime_root}/winsup/cygwin/include"
  local _target_cppflags="-D_WIN64"
  local _runtime_cppflags="${_target_cppflags} -isystem ${_target_include} -idirafter ${_target_w32api}"
  local _runtime_cflags="-O2 -g -D__MSYS__ ${_runtime_cppflags} ${_runtime_source_include}"
  local _runtime_cxxflags="${_runtime_cflags} -nostdinc++ -isystem ${_target_cxx_include} -isystem ${_target_cxx_specific} -isystem ${_target_cxx_backward}"
  local _runtime_library_path="/opt/lib/gcc/aarch64-pc-cygwin/15.0.1:/opt/aarch64-pc-msys/lib"
  local _runtime_link_library_path="${LIBRARY_PATH:+${LIBRARY_PATH}:}${_runtime_library_path}"
  local _default_manifest="/opt/${_install_target}/lib/default-manifest.o"
  local _cc_default_manifest
  local _cc_libgcc _cc_kernel32 _cc_ntdll
  _cc_default_manifest="$(LIBRARY_PATH="${_runtime_link_library_path}" aarch64-pc-cygwin-gcc -print-file-name=default-manifest.o)"
  _cc_libgcc="$(LIBRARY_PATH="${_runtime_link_library_path}" aarch64-pc-cygwin-gcc -print-file-name=libgcc.a)"
  _cc_kernel32="$(LIBRARY_PATH="${_runtime_link_library_path}" aarch64-pc-cygwin-gcc -print-file-name=libkernel32.a)"
  _cc_ntdll="$(LIBRARY_PATH="${_runtime_link_library_path}" aarch64-pc-cygwin-gcc -print-file-name=libntdll.a)"
  printf 'gcc default-manifest.o => %s\n' "${_cc_default_manifest}"
  printf 'explicit default-manifest => %s\n' "${_default_manifest}"
  printf 'gcc libgcc.a => %s\n' "${_cc_libgcc}"
  printf 'gcc libkernel32.a => %s\n' "${_cc_kernel32}"
  printf 'gcc libntdll.a => %s\n' "${_cc_ntdll}"
  test -f "${_default_manifest}"
  test -f "${_cc_libgcc}"
  test -f "${_cc_kernel32}"
  test -f "${_cc_ntdll}"
  aarch64-pc-cygwin-objdump -f "${_default_manifest}" | grep -F "file format pe-aarch64-little"
  aarch64-pc-cygwin-objdump -f "${_cc_libgcc}" | grep -F "architecture: aarch64"
  aarch64-pc-cygwin-objdump -f "${_cc_kernel32}" | grep -F "architecture: aarch64"
  aarch64-pc-cygwin-objdump -f "${_cc_ntdll}" | grep -F "architecture: aarch64"
  if [[ "${_cc_default_manifest}" != "${_default_manifest}" ]]; then
    printf 'using explicit manifest override because compiler lookup returned %s\n' "${_cc_default_manifest}"
  fi
  local -a _runtime_make_vars=(
    "CPPFLAGS=${_runtime_cppflags}"
    "CFLAGS=${_runtime_cflags}"
    "CXXFLAGS=${_runtime_cxxflags}"
    "DEFAULT_MANIFEST=${_default_manifest}"
    "V=1"
  )
  local _newlib_cflags="-O2 -g -D__MSYS__ ${_target_cppflags}"
  local -a _newlib_env=(
   env
   "CPPFLAGS=${CPPFLAGS:-} ${_target_cppflags}"
   "CFLAGS=${CFLAGS:-} ${_newlib_cflags}"
   "CXXFLAGS="
   "CPPFLAGS_FOR_BUILD=${CPPFLAGS_FOR_BUILD:-} ${_target_cppflags}"
   "CFLAGS_FOR_BUILD=${CFLAGS_FOR_BUILD:-} ${_newlib_cflags}"
   "CXXFLAGS_FOR_BUILD="
   "LIBCFLAGS=${LIBCFLAGS:-} ${_newlib_cflags}"
   "LIBCFLAGS_FOR_TARGET=${LIBCFLAGS_FOR_TARGET:-} ${_newlib_cflags}"
   "CPPFLAGS_FOR_TARGET=${CPPFLAGS_FOR_TARGET:-} ${_target_cppflags}"
   "CFLAGS_FOR_TARGET=${CFLAGS_FOR_TARGET:-} ${_newlib_cflags}"
  )
  local -a _runtime_env=(
   env
   "CPPFLAGS=${CPPFLAGS:-} ${_runtime_cppflags}"
   "CFLAGS=${CFLAGS:-} ${_runtime_cflags}"
   "CXXFLAGS=${CXXFLAGS:-} ${_runtime_cxxflags}"
   "LIBRARY_PATH=${_runtime_link_library_path}"
   "CPPFLAGS_FOR_BUILD=${CPPFLAGS_FOR_BUILD:-} ${_runtime_cppflags}"
   "CFLAGS_FOR_BUILD=${CFLAGS_FOR_BUILD:-} ${_runtime_cflags}"
   "CXXFLAGS_FOR_BUILD=${CXXFLAGS_FOR_BUILD:-} ${_runtime_cxxflags}"
   "LIBCFLAGS=${LIBCFLAGS:-} ${_runtime_cflags}"
   "LIBCFLAGS_FOR_TARGET=${LIBCFLAGS_FOR_TARGET:-} ${_runtime_cflags}"
   "CPPFLAGS_FOR_TARGET=${CPPFLAGS_FOR_TARGET:-} ${_runtime_cppflags}"
   "CFLAGS_FOR_TARGET=${CFLAGS_FOR_TARGET:-} ${_runtime_cflags}"
   "CXXFLAGS_FOR_TARGET=${CXXFLAGS_FOR_TARGET:-} ${_runtime_cxxflags}"
  )
  export PATH="/opt/bin:${PATH}"
  export SOURCE_DATE_EPOCH="$(git -C "${startdir}" show -s --format=%ct HEAD)"
  export ac_cv_lib_sframe_sframe_decode=no
  export ac_cv_lib_zstd_ZSTD_isError=no

  (cd "${srcdir}/${_runtime_root}/winsup" && ./autogen.sh)

  rm -rf "${build_dir}"
  mkdir -p "${build_dir}"
  (
    cd "${build_dir}"
    "${_newlib_env[@]}" \
    "${srcdir}/${_runtime_root}/configure" \
        --target="${_build_target}" \
        --prefix="${build_dir}/install" \
        --disable-doc \
        --with-cross-bootstrap \
        --with-msys2-runtime-commit="${_runtime_commit}" \
        CFLAGS_FOR_TARGET="${_newlib_cflags}" \
        CPPFLAGS_FOR_TARGET="${_target_cppflags}"
  )

  mkdir -p "${build_dir}/probe"
  cat > "${build_dir}/probe/runtime-personality.cc" <<'EOF'
#include <basetsd.h>
#include <new>
static_assert(sizeof(void*) == 8, "void* must be 8 bytes");
static_assert(sizeof(UINT_PTR) == 8, "UINT_PTR must be 8 bytes");
int main() { return 0; }
EOF
  cat > "${build_dir}/probe/runtime-personality.c" <<'EOF'
#include <basetsd.h>
_Static_assert(sizeof(void*) == 8, "void* must be 8 bytes");
_Static_assert(sizeof(UINT_PTR) == 8, "UINT_PTR must be 8 bytes");
int main(void) { return 0; }
EOF
  test -f "${srcdir}/${_runtime_root}/winsup/cygwin/include/cygwin/version.h"
  cat > "${build_dir}/probe/runtime-version-header.c" <<'EOF'
#include <cygwin/version.h>
int main(void) { return 0; }
EOF
  aarch64-pc-cygwin-gcc ${_runtime_cflags} -c "${build_dir}/probe/runtime-personality.c" -o "${build_dir}/probe/runtime-personality-c.o"
  aarch64-pc-cygwin-g++ ${_runtime_cxxflags} -c "${build_dir}/probe/runtime-personality.cc" -o "${build_dir}/probe/runtime-personality-cxx.o"
  aarch64-pc-cygwin-gcc ${_runtime_cflags} -c "${build_dir}/probe/runtime-version-header.c" -o "${build_dir}/probe/runtime-version-header.o"

  "${_newlib_env[@]}" make -C "${build_dir}" -j"$(nproc)" all-target-newlib
  "${_runtime_env[@]}" make -C "${build_dir}" configure-target-winsup "${_runtime_make_vars[@]}"
  "${_runtime_env[@]}" make -C "${build_dir}/${_build_target}/winsup/cygwin" -j"$(nproc)" "${_runtime_make_vars[@]}"
}

check() {
  local build_dir="${srcdir}/build-${_build_target}"
  local cygwin_dir="${build_dir}/${_build_target}/winsup/cygwin"
  local newlib_dir="${build_dir}/${_build_target}/newlib"
  local report_dir="${build_dir}/validation"
  local ar="${_build_target}-ar"
  export PATH="/opt/bin:${PATH}"

  rm -rf "${report_dir}"
  mkdir -p "${report_dir}"

  "${srcdir}/${_runtime_root}/.github/checks/validate-aarch64-runtime.sh" \
    "${build_dir}" \
    "${report_dir}"

  test -f "${newlib_dir}/libg.a"
  test -f "${cygwin_dir}/libgmon.a"
  test -f "${newlib_dir}/libc.a"
  diff -u <("${ar}" t "${newlib_dir}/libc.a") \
    <("${ar}" t "${newlib_dir}/libg.a")

  for target_file in \
    /opt/${_install_target}/bin/msys-2.0.dll \
    /opt/${_install_target}/lib/crt0.o \
    /opt/${_install_target}/lib/gcrt0.o \
    /opt/${_install_target}/lib/libaio.a \
    /opt/${_install_target}/lib/libacl.a \
    /opt/${_install_target}/lib/libc.a \
    /opt/${_install_target}/lib/libdl.a \
    /opt/${_install_target}/lib/libg.a \
    /opt/${_install_target}/lib/libgmon.a \
    /opt/${_install_target}/lib/libmsys-2.0.a \
    /opt/${_install_target}/lib/libpthread.a \
    /opt/${_install_target}/lib/libresolv.a \
    /opt/${_install_target}/lib/librt.a \
    /opt/${_install_target}/lib/libssp.a \
    /opt/${_install_target}/lib/libutil.a
  do
    if owner=$(pacman -Qoq "${target_file}" 2>/dev/null); then
      echo "ownership collision for ${target_file}: ${owner}" >&2
      exit 1
    fi
  done
}

package_mingw-w64-cross-msysarm64-runtime() {
  local build_dir="${srcdir}/build-${_build_target}"
  local cygwin_dir="${build_dir}/${_build_target}/winsup/cygwin"
  local pkgroot="${pkgdir}/opt/${_install_target}"
  local license_dir="${pkgdir}/usr/share/licenses/${pkgname}"

  pkgdesc="MSYS runtime DLL for aarch64-pc-msys"
  provides=("aarch64-pc-msys-runtime=${pkgver}")
  conflicts=('aarch64-pc-msys-runtime')
  depends=("mingw-w64-cross-msysarm64-sysroot=${_sysroot_version}-${_sysroot_pkgrel}")

  install -Dm755 "${cygwin_dir}/new-msys-2.0.dll" \
    "${pkgroot}/bin/msys-2.0.dll"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING" "${license_dir}/COPYING"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIB" "${license_dir}/COPYING.LIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.NEWLIB" "${license_dir}/COPYING.NEWLIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIBGLOSS" "${license_dir}/COPYING.LIBGLOSS"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3" "${license_dir}/COPYING3"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3.LIB" "${license_dir}/COPYING3.LIB"
}

package_mingw-w64-cross-msysarm64-runtime-devel() {
  local build_dir="${srcdir}/build-${_build_target}"
  local cygwin_dir="${build_dir}/${_build_target}/winsup/cygwin"
  local newlib_dir="${build_dir}/${_build_target}/newlib"
  local cygserver_dir="${build_dir}/${_build_target}/winsup/cygserver"
  local pkgroot="${pkgdir}/opt/${_install_target}"
  local libdir="${pkgroot}/lib"
  local license_dir="${pkgdir}/usr/share/licenses/${pkgname}"

  pkgdesc="MSYS runtime libraries and startup objects for aarch64-pc-msys"
  depends=(
    "mingw-w64-cross-msysarm64-runtime=${pkgver}-${pkgrel}"
    "mingw-w64-cross-msysarm64-sysroot=${_sysroot_version}-${_sysroot_pkgrel}"
  )
  provides=("aarch64-pc-msys-runtime-devel=${pkgver}")
  conflicts=('aarch64-pc-msys-runtime-devel')
  options=('!strip')

  install -d "${libdir}"

  for file in \
    crt0.o \
    gcrt0.o \
    libaio.a \
    libacl.a \
    libdl.a \
    libgmon.a \
    libg.a \
    libmsys-2.0.a \
    libpthread.a \
    libresolv.a \
    librt.a \
    libssp.a \
    libutil.a
  do
    case "${file}" in
      libg.a)
        src="${newlib_dir}/${file}"
        ;;
      *)
        src="${cygwin_dir}/${file}"
        ;;
    esac
    test -f "${src}"
    install -Dm644 "${src}" "${libdir}/${file}"
  done

  install -Dm644 "${cygserver_dir}/libcygserver.a" \
    "${libdir}/libcygserver.a"

  # Keep the newlib target archives authoritative and package only the
  # source-built runtime layer; headers remain owned by the sysroot package.
  install -Dm644 "${newlib_dir}/libc.a" "${libdir}/libc.a"
  install -Dm644 "${newlib_dir}/libm.a" "${libdir}/libm.a"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING" "${license_dir}/COPYING"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIB" "${license_dir}/COPYING.LIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.NEWLIB" "${license_dir}/COPYING.NEWLIB"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING.LIBGLOSS" "${license_dir}/COPYING.LIBGLOSS"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3" "${license_dir}/COPYING3"
  install -Dm644 "${srcdir}/${_runtime_root}/COPYING3.LIB" "${license_dir}/COPYING3.LIB"
}
