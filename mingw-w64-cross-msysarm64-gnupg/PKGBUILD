prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  patch -p1 -i "${srcdir}/0001-gnupg-2.2.8-msys2.patch"
  patch -p1 -i "${srcdir}/gnupg-2.4-avoid_beta_warning.patch"
  patch -p1 -i "${srcdir}/gnupg-2.4-drop_import_clean.patch"
  patch -p1 -i "${srcdir}/gnupg-2.4-revert_default_rfc4880bis.patch"
  ./autogen.sh --force
}

build() {
  local private_root="${ALTROOT:?ALTROOT must name the fresh private package root}"
  local sysroot="${private_root}${_target_root}"
  local target_usr="${sysroot}/usr"
  local build_dir="${srcdir}/build-${_target}"
  local prefix_map="-ffile-prefix-map=${srcdir}=. -fdebug-prefix-map=${srcdir}=. -fmacro-prefix-map=${srcdir}=."

  test "${private_root}" != "/"
  test "${private_root}" != "/opt"
  test "${private_root}" != "/c/msys64"
  test -f "${sysroot}/bin/msys-2.0.dll"
  test -f "${sysroot}/lib/cygwin-compile-only.specs"
  test -f "${target_usr}/include/gcrypt.h"
  test -f "${target_usr}/include/gpg-error.h"
  test -f "${target_usr}/include/assuan.h"
  test -f "${target_usr}/include/ksba.h"
  test -f "${sysroot}/include/npth.h" -o -f "${target_usr}/include/npth.h"

  rm -rf "${build_dir}" "${srcdir}/dest"
  mkdir -p "${build_dir}" "${srcdir}/dest"

  export PATH="${private_root}/opt/bin:/usr/bin"
  export CC="${private_root}/opt/bin/${_target}-gcc"
  export CXX="${private_root}/opt/bin/${_target}-g++"
  export AR="${private_root}/opt/bin/${_target}-ar"
  export AS="${private_root}/opt/bin/${_target}-as"
  export LD="${private_root}/opt/bin/${_target}-ld"
  export NM="${private_root}/opt/bin/${_target}-nm"
  export OBJDUMP="${private_root}/opt/bin/${_target}-objdump"
  export RANLIB="${private_root}/opt/bin/${_target}-ranlib"
  export STRIP="${private_root}/opt/bin/${_target}-strip"
  export DLLTOOL="${private_root}/opt/bin/${_target}-dlltool"
  export WINDRES="${private_root}/opt/bin/${_target}-windres"
  export CC_FOR_BUILD='gcc'
  export PKG_CONFIG='/usr/bin/pkg-config'
  export PKG_CONFIG_LIBDIR="${target_usr}/lib/pkgconfig:${sysroot}/lib/pkgconfig"
  export PKG_CONFIG_SYSROOT_DIR="${private_root}"
  export CPPFLAGS="-D__MSYS__ -isystem ${sysroot}/include -isystem ${sysroot}/include/w32api -isystem ${target_usr}/include"
  export CFLAGS="-O2 -pipe ${prefix_map}"
  export CXXFLAGS="${CFLAGS}"
  export LDFLAGS="--sysroot=${sysroot} -specs=${sysroot}/lib/cygwin-compile-only.specs -L${target_usr}/lib -L${sysroot}/lib -Wl,-u,_pei386_runtime_relocator"
  export LIBS='-lmsys-2.0'
  export lt_cv_deplibs_check_method='pass_all'
  export lt_cv_archive_cmds_need_lc='no'

  test "$("${CC}" -dumpmachine)" = "${_target}"
  "${OBJDUMP}" -f "${CC}" | grep -Eq 'pei-x86-64|pe-x86-64'

  (
    cd "${build_dir}"
    "${srcdir}/${_realname}-${pkgver}/configure" \
      --build="${CHOST}" \
      --host="${_target}" \
      --target="${_target}" \
      --prefix=/usr \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --sbindir=/usr/bin \
      --libexecdir=/usr/lib/gnupg \
      --disable-libdns \
      --disable-ldap \
      --disable-gnutls \
      --disable-nls \
      --enable-bzip2 \
      --enable-sqlite \
      --enable-gpgsm \
      --enable-dirmngr \
      --enable-wks-tools \
      --enable-maintainer-mode
  )

  make -C "${build_dir}" -j"$(nproc)"
  make -C "${build_dir}" DESTDIR="${srcdir}/dest" install
}

check() {
  local private_root="${ALTROOT:?ALTROOT must name the fresh private package root}"
  local target_usr="${private_root}${_target_root}/usr"
  local stage="${srcdir}/dest/usr"
  local work="${srcdir}/check"
  local expected actual

  rm -rf "${work}"
  mkdir -p "${work}"

  expected="$(jq -r '.expected_pe[]' "${srcdir}/inventory.json" | sort)"
  actual="$(
    cd "${stage}"
    find bin lib/gnupg -type f \( -iname '*.exe' -o -iname '*.dll' \) -printf '%p\n' | sort
  )"
  diff -u <(printf '%s\n' "${expected}") <(printf '%s\n' "${actual}")

  while IFS= read -r pe; do
    "${private_root}/opt/bin/${_target}-objdump" -f "${stage}/${pe}" |
      grep -F 'architecture: aarch64'
    "${private_root}/opt/bin/${_target}-objdump" -f "${stage}/${pe}" |
      grep -F 'file format pei-aarch64-little'
    "${private_root}/opt/bin/${_target}-objdump" -p "${stage}/${pe}" |
      grep -Fi 'DLL Name: msys-2.0.dll'
    ! "${private_root}/opt/bin/${_target}-objdump" -p "${stage}/${pe}" |
      grep -Eqi 'cygwin1\.dll|x86_64|mingw'
  done < <(jq -r '.expected_pe[]' "${srcdir}/inventory.json")

  cat > "${work}/gpg-error-consumer.c" <<'EOF'
#include <gpg-error.h>
int main(void) { return gpg_err_code(GPG_ERR_NO_ERROR); }
EOF
  "${private_root}/opt/bin/${_target}-gcc" \
    --sysroot="${private_root}${_target_root}" \
    -specs="${private_root}${_target_root}/lib/cygwin-compile-only.specs" \
    -I"${target_usr}/include" \
    "${work}/gpg-error-consumer.c" \
    -L"${target_usr}/lib" -lgpg-error \
    -o "${work}/gpg-error-consumer.exe"
  "${private_root}/opt/bin/${_target}-objdump" -f "${work}/gpg-error-consumer.exe" |
    grep -F 'architecture: aarch64'
}

package_mingw-w64-cross-msysarm64-gnupg() {
  pkgdesc="Native ARM64 MSYS GnuPG programs for aarch64-pc-msys"
  depends=(
    'mingw-w64-cross-msysarm64-runtime=0.unresolved'
    'mingw-w64-cross-msysarm64-gcc-libs=15.0.1dev-1'
    'mingw-w64-cross-msysarm64-npth=0.unresolved'
    'mingw-w64-cross-msysarm64-libgpg-error=0.unresolved'
    'mingw-w64-cross-msysarm64-libgcrypt=0.unresolved'
    'mingw-w64-cross-msysarm64-libassuan=0.unresolved'
    'mingw-w64-cross-msysarm64-libksba=0.unresolved'
    'mingw-w64-cross-msysarm64-readline=0.unresolved'
    'mingw-w64-cross-msysarm64-zlib=0.unresolved'
    'mingw-w64-cross-msysarm64-libbz2=0.unresolved'
    'mingw-w64-cross-msysarm64-libsqlite=0.unresolved'
    'mingw-w64-cross-msysarm64-libiconv=0.unresolved'
    'mingw-w64-cross-msysarm64-pinentry=0.unresolved'
  )
  provides=("aarch64-pc-msys-gnupg=${pkgver}" "aarch64-pc-msys-dirmngr=${pkgver}")
  conflicts=('aarch64-pc-msys-gnupg' 'aarch64-pc-msys-dirmngr')

  install -d "${pkgdir}${_target_root}/usr/share"
  cp -a "${srcdir}/dest/usr/bin" "${pkgdir}${_target_root}/usr/"
  cp -a "${srcdir}/dest/usr/lib" "${pkgdir}${_target_root}/usr/"
  cp -a "${srcdir}/dest/usr/share/gnupg" "${pkgdir}${_target_root}/usr/share/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

package_mingw-w64-cross-msysarm64-gnupg-docs() {
  pkgdesc="Documentation for native ARM64 MSYS GnuPG"
  depends=("mingw-w64-cross-msysarm64-gnupg=${pkgver}-${pkgrel}")

  install -d "${pkgdir}${_target_root}/usr/share"
  cp -a "${srcdir}/dest/usr/share/doc" "${pkgdir}${_target_root}/usr/share/"
  cp -a "${srcdir}/dest/usr/share/info" "${pkgdir}${_target_root}/usr/share/"
  cp -a "${srcdir}/dest/usr/share/man" "${pkgdir}${_target_root}/usr/share/"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
