_realname=gnupg
_target=aarch64-pc-msys
_target_root="/opt/${_target}"

pkgbase=mingw-w64-cross-msysarm64-gnupg
pkgname=(
  mingw-w64-cross-msysarm64-gnupg
  mingw-w64-cross-msysarm64-gnupg-docs
)
pkgver=2.4.7
pkgrel=1
pkgdesc="Native ARM64 MSYS implementation of the OpenPGP standard"
arch=('x86_64')
url='https://gnupg.org/'
license=('spdx:GPL-3.0-or-later')
groups=('mingw-w64-cross-toolchain' 'mingw-w64-cross')
msys2_repository_url='https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gnupg.git'
msys2_references=('cpe: cpe:/a:gnupg:gnupg')
depends=()
makedepends=(
  'autotools'
  'gcc'
  'gettext-devel'
  'pkgconf'
  'mingw-w64-cross-cygwinarm64-binutils=2.44.50-2'
  'mingw-w64-cross-msysarm64-gcc=15.0.1dev-1'
  'mingw-w64-cross-msysarm64-gcc-libs=15.0.1dev-1'
  'mingw-w64-cross-msysarm64-runtime-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-sysroot=0.unresolved'
  'mingw-w64-cross-msysarm64-w32api-runtime=14.0.0.r0.g9b3dd0125-1'
  'mingw-w64-cross-msysarm64-npth-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libgpg-error-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libgcrypt-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libassuan-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libksba-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-readline-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-zlib-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libbz2-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libsqlite-devel=0.unresolved'
  'mingw-w64-cross-msysarm64-libiconv-devel=0.unresolved'
)
options=('!strip' '!buildflags' '!emptydirs')
source=(
  "https://gnupg.org/ftp/gcrypt/${_realname}/${_realname}-${pkgver}.tar.bz2"
  "https://gnupg.org/ftp/gcrypt/${_realname}/${_realname}-${pkgver}.tar.bz2.sig"
  '../gnupg/0001-gnupg-2.2.8-msys2.patch'
  '../gnupg/gnupg-2.4-avoid_beta_warning.patch'
  '../gnupg/gnupg-2.4-drop_import_clean.patch'
  '../gnupg/gnupg-2.4-revert_default_rfc4880bis.patch'
  'dependencies.lock.json'
  'inventory.json'
)
