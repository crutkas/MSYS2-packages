# Declare files that always have LF line endings on checkout
* text eol=lf

# Keep the ncurses patch payload byte-stable on Windows checkouts.
mingw-w64-cross-msysarm64-ncurses/*.patch binary

# Windows batch files need to have CRLF line endings on checkout
*.cmd text eol=crlf

# Denote all files that are truly binary and should not be modified
*.bz2 binary
*.gz binary
*.xz binary
*.exe binary
*.dll binary
*.lzma binary
*.ttf binary
*.tgz binary
*.zip binary
*.rar binary
*.lib binary
*.a binary
*.ico binary