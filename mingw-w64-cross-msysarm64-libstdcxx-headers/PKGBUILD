_gcc_build=build-${_target}-libstdcxx-headers
_libstdcxx_build=${_gcc_build}/${_target}/libstdc++-v3
_stage=stage-${_target}-libstdcxx-headers
_report=libstdcxx-headers-report

prepare() {
  cd "${srcdir}/${_gcc_root}"
  patch -Np1 -i \
    "${srcdir}/0001-libstdcxx-cygwin-bootstrap-features.patch"
}

_configure_bootstrap_compiler() {
  local _builddir="${srcdir}/${_gcc_build}"
  local _source="${srcdir}/${_gcc_root}"
  local _prefix_map="-ffile-prefix-map=${srcdir}=. -fdebug-prefix-map=${srcdir}=. -fmacro-prefix-map=${srcdir}=."
  local -a _args=(
    "--build=${_host}"
    "--host=${_host}"
    "--target=${_target}"
    '--prefix=/opt'
    '--libexecdir=/opt/libexec'
    "--with-sysroot=/opt/${_target}"
    "--with-build-sysroot=/opt/${_target}"
    "--with-build-time-tools=/opt/${_target}/bin"
    '--with-native-system-header-dir=/include'
    '--with-newlib'
    '--with-abi=lp64'
    '--with-arch=armv8-a'
    '--enable-multilib'
    '--with-multilib-list=lp64'
    '--enable-languages=c,c++,lto'
    '--enable-lto'
    '--disable-plugin'
    '--enable-static'
    '--disable-shared'
    '--disable-bootstrap'
    '--disable-nls'
    '--disable-rpath'
    '--enable-threads=posix'
    '--disable-win32-registry'
    '--disable-werror'
    '--disable-libada'
    '--disable-libatomic'
    '--disable-libcc1'
    '--disable-libffi'
    '--disable-libgfortran'
    '--disable-libgm2'
    '--disable-libgomp'
    '--disable-libitm'
    '--disable-libobjc'
    '--disable-libphobos'
    '--disable-libquadmath'
    '--disable-libsanitizer'
    '--disable-libssp'
    '--disable-libstdcxx'
    '--disable-libvtv'
    '--with-gmp=/usr'
    '--with-isl=/usr'
    '--with-mpc=/usr'
    '--with-mpfr=/usr'
    '--with-system-zlib'
  )

  mkdir -p "${_builddir}" "${srcdir}/${_report}"
  (
    cd "${_builddir}"
    CFLAGS="-O2 -pipe ${_prefix_map}" \
    CXXFLAGS="-O2 -pipe ${_prefix_map}" \
    CFLAGS_FOR_BUILD="-O2 -pipe ${_prefix_map}" \
    CXXFLAGS_FOR_BUILD="-O2 -pipe ${_prefix_map}" \
      "${_source}/configure" "${_args[@]}"
  )

  printf '%s\n' "${_args[@]}" \
    > "${srcdir}/${_report}/gcc-configure-args.txt"
}

_prepare_gcc_private_headers() {
  local _builddir="${srcdir}/${_gcc_build}"
  local _private_include="${_builddir}/gcc/include"
  local _private_include_fixed="${_builddir}/gcc/include-fixed"

  if ! make -C "${_builddir}/gcc" MAKEINFO=true stmp-int-hdrs; then
    make -C "${_builddir}" MAKEINFO=true all-gcc
  fi

  test -d "${_private_include}"
  test -d "${_private_include_fixed}"
  test -f "${_private_include}/limits.h" || test -f "${_private_include_fixed}/limits.h"
  test -f "${_private_include}/stddef.h" || test -f "${_private_include_fixed}/stddef.h"

  {
    printf 'private-include\t%s\n' "${_private_include}"
    printf 'private-include-fixed\t%s\n' "${_private_include_fixed}"
    find "${_private_include}" -maxdepth 1 -type f \
      \( -name 'limits.h' -o -name 'stddef.h' -o -name 'stdint.h' -o -name 'syslimits.h' \) \
      | LC_ALL=C sort
    find "${_private_include_fixed}" -maxdepth 1 -type f \
      \( -name 'limits.h' -o -name 'stddef.h' -o -name 'stdint.h' -o -name 'syslimits.h' \) \
      | LC_ALL=C sort
  } > "${srcdir}/${_report}/gcc-private-headers.txt"
}

_probe_libstdcxx_preprocessor() {
  local _builddir="${srcdir}/${_gcc_build}"
  local _probe_dir="${srcdir}/${_report}/preprocessor-probes"
  local _xgcc="${_builddir}/gcc/xgcc.exe"
  local _private_include="${_builddir}/gcc/include"
  local _private_include_fixed="${_builddir}/gcc/include-fixed"
  local _cppflags="-isystem ${_private_include} -isystem ${_private_include_fixed} -isystem /opt/${_target}/include -idirafter /opt/${_target}/include/w32api"
  local _target_flags="-B${_builddir}/gcc/ -B/opt/libexec/gcc/${_target}/${_gcc_version}/ -B/opt/${_target}/bin/ -B/opt/${_target}/lib/ ${_cppflags} --sysroot=/opt/${_target}"
  mkdir -p "${_probe_dir}"

  printf '/* confdefs.h */\n#include <limits.h>\n' \
    > "${_probe_dir}/conftest-limits.c"
  if ! env \
    CPPFLAGS="${_cppflags}" \
      "${_xgcc}" -E -x c ${_target_flags} "${_probe_dir}/conftest-limits.c" \
      > "${_probe_dir}/conftest-limits.i" \
      2> "${_probe_dir}/conftest-limits.err"; then
    {
      printf 'limits.h sanity\tfailed\n'
      cat "${_probe_dir}/conftest-limits.err"
    } > "${srcdir}/${_report}/preprocessor-sanity.txt"
    return 1
  fi

  printf '/* confdefs.h */\n#include <ac_nonexistent.h>\n' \
    > "${_probe_dir}/conftest-nonexistent.c"
  if env \
    CPPFLAGS="${_cppflags}" \
      "${_xgcc}" -E -x c ${_target_flags} "${_probe_dir}/conftest-nonexistent.c" \
      > "${_probe_dir}/conftest-nonexistent.i" \
      2> "${_probe_dir}/conftest-nonexistent.err"; then
    {
      printf 'limits.h sanity\tok\n'
      printf 'ac_nonexistent.h sanity\tunexpected-success\n'
      cat "${_probe_dir}/conftest-nonexistent.err"
    } > "${srcdir}/${_report}/preprocessor-sanity.txt"
    return 1
  fi

  {
    printf 'limits.h sanity\tok\n'
    printf 'ac_nonexistent.h sanity\texpected-failure\n'
    "${_xgcc}" -print-prog-name=cc1
    "${_xgcc}" -print-prog-name=cc1plus
    "${_xgcc}" -print-prog-name=collect2
    "${_xgcc}" -print-prog-name=as
    "${_xgcc}" -print-search-dirs
  } > "${srcdir}/${_report}/preprocessor-sanity.txt"
}

_dump_libstdcxx_config_failure() {
  local _libbuild="${srcdir}/${_libstdcxx_build}"
  local _reportdir="${srcdir}/${_report}"
  cp -f "${_libbuild}/config.log" "${_reportdir}/config.log"
  if [[ -f "${_libbuild}/config.err" ]]; then
    cp -f "${_libbuild}/config.err" "${_reportdir}/config.err"
  fi
  {
    printf '=== ac_fn_c_try_cpp / config.log context ===\n'
    grep -n -A20 -B20 -E 'ac_fn_c_try_cpp|ac_nonexistent.h|limits.h|conftest.err|fails sanity check' "${_libbuild}/config.log"
  } > "${_reportdir}/config-log-context.txt" 2>&1 || true
}

_configure_libstdcxx() {
  local _builddir="${srcdir}/${_gcc_build}"
  local _libbuild="${srcdir}/${_libstdcxx_build}"
  local _source="${srcdir}/${_gcc_root}"
  local _tool_target=aarch64-pc-cygwin
  local _xgcc="${_builddir}/gcc/xgcc.exe"
  local _private_include="${_builddir}/gcc/include"
  local _private_include_fixed="${_builddir}/gcc/include-fixed"
  local _cppflags="-isystem ${_private_include} -isystem ${_private_include_fixed} -isystem /opt/${_target}/include -idirafter /opt/${_target}/include/w32api"
  local _target_flags="-B${_builddir}/gcc/ -B/opt/libexec/gcc/${_target}/${_gcc_version}/ -B/opt/${_target}/bin/ -B/opt/${_target}/lib/ ${_cppflags} --sysroot=/opt/${_target}"
  local _runtime="${srcdir}/${_runtime_root}"
  local -a _args=(
    '--cache-file=./config.cache'
    "--with-cross-host=${_host}"
    '--prefix=/opt'
    '--libexecdir=/opt/libexec'
    '--with-newlib'
    '--disable-multilib'
    '--enable-libstdcxx-threads'
    '--disable-libstdcxx-pch'
    '--enable-static'
    '--disable-shared'
    '--disable-nls'
    "--with-gxx-include-dir=/opt/${_target}/include/c++/${_gcc_version}"
    "--with-target-subdir=${_target}"
    "--build=${_host}"
    "--host=${_target}"
    "--target=${_target}"
  )

  local _libgcc_build="${_builddir}/${_target}/libgcc"
  mkdir -p "${_libbuild}" "${_libgcc_build}"
  install -m644 "${_source}/libgcc/gthr-posix.h" \
    "${_libgcc_build}/gthr-default.h"

  (
    cd "${_libbuild}"
    if ! env \
      CONFIG_SITE=no-such-file \
      CPP="${_xgcc} -E -x c ${_target_flags}" \
      CPPFLAGS="${_cppflags}" \
      AR="/opt/bin/${_tool_target}-ar" \
      AS="/opt/bin/${_tool_target}-as" \
      CC="${_xgcc} ${_target_flags}" \
      CFLAGS='-O2 -pipe -D_WIN64' \
      CXX="${_xgcc} -shared-libgcc -nostdinc++ ${_target_flags}" \
      CXXCPP="${_xgcc} -E -x c++ ${_target_flags}" \
      CXXFLAGS='-O2 -pipe -D_WIN64' \
      LD="/opt/bin/${_tool_target}-ld" \
      NM="/opt/bin/${_tool_target}-nm" \
      OBJCOPY="/opt/bin/${_tool_target}-objcopy" \
      OBJDUMP="/opt/bin/${_tool_target}-objdump" \
      RANLIB="/opt/bin/${_tool_target}-ranlib" \
      READELF="/opt/bin/${_tool_target}-readelf" \
      STRIP="/opt/bin/${_tool_target}-strip" \
      WINDMC="/opt/bin/${_tool_target}-windmc" \
      WINDRES="/opt/bin/${_tool_target}-windres" \
        "${_source}/libstdc++-v3/configure" "${_args[@]}"; then
      _dump_libstdcxx_config_failure
      echo '=== xgcc preprocessor probes ==='
      "${_xgcc}" -print-prog-name=cc1
      "${_xgcc}" -print-prog-name=cc1plus
      "${_xgcc}" -print-prog-name=collect2
      "${_xgcc}" -print-prog-name=as
      "${_xgcc}" -print-search-dirs
      echo '=== config.log excerpt ==='
      sed -n '836,846p' config.log
      grep -n -A20 -B20 'fails sanity check' config.log || tail -n 120 config.log
      return 1
    fi
  )

  printf '%s\n' "${_args[@]}" \
    > "${srcdir}/${_report}/libstdcxx-configure-args.txt"
}

_report_build_failure() {
  local _command="${1}"
  local _line="${2}"
  local _reportdir="${srcdir}/${_report}"
  mkdir -p "${_reportdir}"
  {
    printf 'command\t%s\n' "${_command}"
    printf 'line\t%s\n' "${_line}"
  } > "${_reportdir}/validation-failure.txt"
}

build() {
  rm -rf \
    "${srcdir:?}/${_gcc_build}" \
    "${srcdir:?}/${_stage}" \
    "${srcdir:?}/${_report}"
  mkdir -p "${srcdir}/${_stage}" "${srcdir}/${_report}"

  export MSYSTEM=MSYS
  export lt_cv_deplibs_check_method=pass_all
  set -E
  trap '_report_build_failure "$BASH_COMMAND" "$LINENO"' ERR

  _configure_bootstrap_compiler
  make -C "${srcdir}/${_gcc_build}" MAKEINFO=true \
    configure-gcc \
    all-build-libiberty \
    all-libiberty \
    all-build-libcpp \
    all-libcpp \
    all-libdecnumber \
    all-libbacktrace
  make -C "${srcdir}/${_gcc_build}/gcc" MAKEINFO=true xgcc.exe
  make -C "${srcdir}/${_gcc_build}" MAKEINFO=true all-libcody
  make -C "${srcdir}/${_gcc_build}/gcc" MAKEINFO=true cc1.exe cc1plus.exe
  _prepare_gcc_private_headers
  "${srcdir}/${_gcc_build}/gcc/xgcc.exe" \
    -B"${srcdir}/${_gcc_build}/gcc/" \
    -B"/opt/libexec/gcc/${_target}/${_gcc_version}/" \
    -v -E -x c++ /dev/null 2>&1 \
    | tee "${srcdir}/${_report}/bootstrap-compiler.txt"
  grep -Fx 'Thread model: posix' \
    "${srcdir}/${_report}/bootstrap-compiler.txt"
  _probe_libstdcxx_preprocessor

  _configure_libstdcxx
  make -C "${srcdir}/${_libstdcxx_build}/include" all-local
  make -C "${srcdir}/${_libstdcxx_build}/include" \
    DESTDIR="${srcdir}/${_stage}" install-headers
  make -C "${srcdir}/${_libstdcxx_build}/libsupc++" \
    DESTDIR="${srcdir}/${_stage}" \
    install-stdHEADERS install-bitsHEADERS

  local _include="${srcdir}/${_stage}/opt/${_target}/include/c++/${_gcc_version}"
  local _sharedir="${srcdir}/${_stage}/opt/${_target}/share/msys-sysroot/libstdcxx-headers"
  mkdir -p "${_sharedir}"

  if ! (
    cd "${srcdir}/${_stage}"
    find "opt/${_target}/include/c++/${_gcc_version}" \
      -type f -print0 \
      | LC_ALL=C sort -z \
      | xargs -0 sha256sum
  ) > "${_sharedir}/header-manifest.sha256" 2> "${srcdir}/${_report}/header-manifest.err"; then
    echo "header manifest generation failed" > "${srcdir}/${_report}/validation-failure.txt"
    return 1
  fi
  if ! sed 's/^[[:xdigit:]]\{64\} [* ]//' \
    "${_sharedir}/header-manifest.sha256" \
    > "${_sharedir}/header-manifest.txt"; then
    echo "header manifest normalization failed" > "${srcdir}/${_report}/validation-failure.txt"
    return 1
  fi

  {
    sha256sum \
      "${srcdir}/${_gcc_root}/configure" \
      "${srcdir}/${_gcc_root}/libstdc++-v3/configure" \
      "${srcdir}/${_report}/gcc-configure-args.txt" \
      "${srcdir}/${_report}/libstdcxx-configure-args.txt" \
      "${srcdir}/0001-libstdcxx-cygwin-bootstrap-features.patch" \
      "${srcdir}/${_libstdcxx_build}/config.h" \
      "${_include}/${_target}/bits/c++config.h"
  } | sed \
    -e "s#${srcdir}/${_gcc_root}/##" \
    -e "s#${srcdir}/${_report}/##" \
    -e "s#${srcdir}/${_libstdcxx_build}/##" \
    -e "s#${_include}/##" \
    -e "s#${srcdir}/##" \
    > "${srcdir}/${_report}/configuration-sha256.txt"

  cat > "${srcdir}/${_report}/source-identity.txt" <<EOF
package-version	${pkgver}-${pkgrel}
gcc-repository	https://github.com/crutkas/gcc-woarm64
gcc-commit	${_gcc_commit}
gcc-archive-sha256	3ab5b2a037d027ab4e69b5597f2a82e77e87bca79ee764381a717b2e8328d060
runtime-validation-repository	https://github.com/crutkas/msys2-runtime
runtime-validation-commit	${_runtime_commit}
runtime-validation-archive-sha256	f9a6bd4366802d05d43b7c3876fceb92b93b89b172eebb020d48d2fb36389f89
stage0-package-base	389051fb5aab566707a95fd69d73f5659e02c696
sysroot-runtime-commit	6922c388be93e423c1186f0b58c39380a5ee9e2d
sysroot-runtime-archive-sha256	f9a6bd4366802d05d43b7c3876fceb92b93b89b172eebb020d48d2fb36389f89
sysroot-w32api-snapshot-sha256	48f71ba7e14629455259e4a618c0585f31120f51544b88a39cf60f9e8faa2424
w32api-runtime-commit	9b3dd0125792fe94d16cacdc596dbd42fca1b369
w32api-runtime-archive-sha256	a538427786ab530b253c8350a9b4c14e511032f8900366336b29065ad23de129
target	${_target}
abi	lp64
thread-model	posix
tls-feature	disabled-until-target-link-libraries-exist
installed-libraries	0
EOF

  cp \
    "${srcdir}/${_report}/gcc-configure-args.txt" \
    "${srcdir}/${_report}/libstdcxx-configure-args.txt" \
    "${srcdir}/${_report}/configuration-sha256.txt" \
    "${srcdir}/${_report}/source-identity.txt" \
    "${_sharedir}/"

  bash "${srcdir}/validate-libstdcxx-headers.sh" \
    "${srcdir}/${_stage}/opt" \
    "${srcdir}/${_report}" \
    "${srcdir}/${_runtime_root}" \
    "${srcdir}/runtime-build-${_target}" \
    "${srcdir}"

  cp "${srcdir}/${_report}/"* "${_sharedir}/"
  install -m644 \
    "${srcdir}/0001-libstdcxx-cygwin-bootstrap-features.patch" \
    "${srcdir}/README.md" \
    "${srcdir}/atomic.cc" \
    "${srcdir}/exceptions.cc" \
    "${srcdir}/header-features.cc" \
    "${_sharedir}/"
  install -m755 \
    "${srcdir}/validate-libstdcxx-headers.sh" \
    "${_sharedir}/"

  test "$(find "${_include}" -type f | wc -l)" -gt 800
  test -z "$(
    find "${srcdir}/${_stage}" -type f \
      \( -name '*.a' -o -name '*.dll' -o -name '*.exe' -o -name '*.o' \) \
      -print -quit
  )"
}

check() {
  local _stage_root="${srcdir}/${_stage}"
  local _sharedir="opt/${_target}/share/msys-sysroot/libstdcxx-headers"

  (
    cd "${_stage_root}"
    sha256sum -c "${_sharedir}/header-manifest.sha256"
  )
  python -m json.tool \
    "${_stage_root}/${_sharedir}/validation-report.json" \
    > /dev/null
  grep -Fx $'installed-libraries\t0' \
    "${_stage_root}/${_sharedir}/source-identity.txt"
}

package() {
  cp -a "${srcdir}/${_stage}/." "${pkgdir}/"

  local _licensedir="${pkgdir}/opt/share/licenses/${pkgname}"
  mkdir -p "${_licensedir}"
  install -m644 \
    "${srcdir}/${_gcc_root}/COPYING3" \
    "${srcdir}/${_gcc_root}/COPYING.RUNTIME" \
    "${_licensedir}/"
}
